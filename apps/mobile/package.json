    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-media-library": "~57.0.5",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-speech-recognition": "~57.1.0",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.24",
    "expo-web-browser": "~57.0.3",
    "html2canvas": "^1.4.1",
    "lucide-react-native": "^0.461.0",
    "mobx": "^6.13.5",
    "mobx-react-lite": "^4.1.1",
    "mobx-state-tree": "^6.0.1",
    "monaco-editor": "^0.55.1",
    "nativewind": "^4.1.23",
    "posthog-react-native": "^4.37.2",
    "react": "19.2.3",
    "react-aria": "^3.33.0",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-gifted-charts": "^1.4.74",
    "react-native-iap": "^12.15.0",
    "react-native-marked": "^8.0.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-stately": "^3.39.0",
    "shiki": "^4.0.2",
    "streamdown": "^2.3.0",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^0.1.20",
    "three": "^0.180.0"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "react-native-reanimated",
        "react-native-worklets"
      ]
    },
    "install": {
      "exclude": [
        "@sentry/react-native",
        "typescript"
      ]
    }
  },
  "devDependencies": {
    "@babel/plugin-transform-class-static-block": "^7.28.3",
    "@expo/metro-runtime": "~57.0.16",
    "@happy-dom/global-registrator": "^20.9.0",
    "@sentry/cli": "^3.4.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "~19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/web": "^0.0.349",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-preset-expo": "~57.0.0",
    "happy-dom": "^20.9.0",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react-devtools-core": "^6.1.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
