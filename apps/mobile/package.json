{
  "name": "@shogo/mobile",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "main": "./index.js",
  "scripts": {
    "dev": "node scripts/copy-monaco-vs.mjs && expo start",
    "dev:web": "node scripts/start-web.mjs",
    "dev:ios": "expo start --ios",
    "dev:android": "expo start --android",
    "build": "node scripts/copy-monaco-vs.mjs && expo export --platform web --source-maps && node scripts/inject-theme-bootstrap.js",
    "build:buddy-webview": "bun scripts/build-buddy-webview.ts",
    "typecheck": "bun ../../scripts/run-mobile-typecheck.ts",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:android:dev": "eas build --platform android --profile development",
    "build:android": "eas build --platform android --profile preview",
    "build:android:prod": "eas build --platform android --profile production",
    "build:android:local": "eas build --platform android --profile preview --local",
    "prebuild:native": "expo prebuild --clean",
    "eas-build-post-install": "cd ../../packages/sdk && bun run build",
    "bundle:monaco-types": "node scripts/bundle-monaco-types.mjs",
    "copy:monaco-vs": "node scripts/copy-monaco-vs.mjs",
    "test": "bun --no-env-file ../../scripts/run-tests-isolated.ts . --roots app,components,lib,stubs,test",
    "test:watch": "bun --no-env-file test --watch",
    "test:coverage": "bun --no-env-file ../../scripts/run-tests-isolated.ts . --roots app,components,lib,stubs,test --coverage",
    "devtools": "bunx react-devtools"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.299",
    "@better-auth/expo": "^1.4.19",
    "@elevenlabs/react": "^1.1.1",
    "@expo/html-elements": "^0.10.1",
    "@expo/vector-icons": "^15.0.3",
    "@gluestack-ui/core": "^3.0.10",
    "@gluestack-ui/utils": "^3.0.11",
    "@legendapp/motion": "^2.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "^8.12.0",
    "@shogo-ai/sdk": "workspace:*",
    "@shogo/desktop-terminal": "workspace:*",
    "@shogo/domain-stores": "workspace:*",
    "@shogo/model-catalog": "workspace:*",
    "@shogo/shared-app": "workspace:*",
    "@shogo/shared-ui": "workspace:*",
    "@shogo/ui-kit": "workspace:*",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@ungap/structured-clone": "^1.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^6.0.296",
    "better-auth": "^1.2.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "expo": "~57.0.0",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
