{
  "expo": {
    "name": "Shogo",
    "slug": "shogo",
    "version": "1.0.10",
    "orientation": "default",
    "icon": "./assets/shogo-icon.png",
    "scheme": "shogo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.shogo.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "scheme": "shogo"
    },
    "android": {
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FB8C00"
      },
      "package": "ai.shogo.mobile",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 80,
          "resizeMode": "contain",
          "backgroundColor": "#121212"
        }
      ],
      "expo-apple-authentication",
      "react-native-iap",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Shogo to access your photos so you can attach them to messages.",
          "cameraPermission": "Allow Shogo to use the camera so you can attach photos to messages and turn on video in huddles."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Shogo to save generated images to your photo library.",
          "granularPermissions": []
        }
      ],
      "expo-document-picker",
      "expo-secure-store",
      "expo-web-browser",
      "expo-localization",
      [
        "@sentry/react-native/expo",
        {
          "organization": "shogo-ai",
          "project": "shogo-ios"
        }
      ],
      "./plugins/withRemoveOrientationLocks",
      "./plugins/withAndroidEdgeToEdge",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Shogo uses your microphone to record your voice when you tap the mic button in chat, so the AI can transcribe what you say into a prompt — for example, asking \"summarize my last meeting notes.\" Audio is processed only to generate the transcript and is not stored.",
          "speechRecognitionPermission": "Shogo uses Apple's on-device speech recognition to convert your dictated voice into text in the chat input — for example, when you say \"create a new task for tomorrow,\" it appears as text you can edit before sending."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#FB8C00"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Shogo records meetings you start so it can transcribe them and write your notes, and uses your microphone when you talk in a huddle.",
          "enableBackgroundRecording": true
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "expo-font",
      "expo-asset",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1523dfce-1689-48f6-b921-68d992ff05c5"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/1523dfce-1689-48f6-b921-68d992ff05c5"
    }
  }
}
