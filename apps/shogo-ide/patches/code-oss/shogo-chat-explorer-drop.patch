+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Shogo Technologies, Inc. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../base/test/common/utils.js';
+import { fileUriFromPath, isShogoChatResourceDrag, mergeShogoChatDropUris, parseShogoChatDropData, ShogoDropDataTransfer } from '../../browser/shogoChatDropData.js';
+
+function transfer(data: Record<string, string>): ShogoDropDataTransfer {
+	return { types: Object.keys(data), getData: format => data[format] ?? '' };
+}
+
+suite('Shogo chat explorer drop', () => {
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	test('recognises resource drags only', () => {
+		assert.strictEqual(isShogoChatResourceDrag(['ResourceURLs']), true);
+		assert.strictEqual(isShogoChatResourceDrag(['CodeFiles']), true);
+		assert.strictEqual(isShogoChatResourceDrag(['Files']), false);
+		assert.strictEqual(isShogoChatResourceDrag(['text/uri-list']), true);
+		assert.strictEqual(isShogoChatResourceDrag(['application/vnd.code.tree.views']), false);
+		assert.strictEqual(isShogoChatResourceDrag([]), false);
+		assert.strictEqual(isShogoChatResourceDrag(undefined), false);
+	});
+
+	test('reads ResourceURLs JSON', () => {
+		const uris = parseShogoChatDropData(transfer({ ResourceURLs: JSON.stringify(['file:///repo/a.ts', 'file:///repo/src']) }));
+		assert.deepStrictEqual(uris, ['file:///repo/a.ts', 'file:///repo/src']);
+	});
+
+	test('reads CodeFiles JSON paths as file URIs', () => {
+		const uris = parseShogoChatDropData(transfer({ CodeFiles: JSON.stringify(['/repo/a b.ts', 'C:\\repo\\b.ts']) }));
+		assert.deepStrictEqual(uris, ['file:///repo/a%20b.ts', 'file:///C:/repo/b.ts']);
+	});
+
+	test('reads CodeEditors resources and text/uri-list', () => {
+		const uris = parseShogoChatDropData(transfer({
+			CodeEditors: JSON.stringify([{ resource: { scheme: 'file', authority: '', path: '/repo/c.ts' } }]),
+			'text/uri-list': '# comment\r\nfile:///repo/d.ts\r\n',
+		}));
+		assert.deepStrictEqual(uris, ['file:///repo/c.ts', 'file:///repo/d.ts']);
+	});
+
+	test('no or malformed data yields nothing', () => {
+		assert.deepStrictEqual(parseShogoChatDropData(transfer({})), []);
+		assert.deepStrictEqual(parseShogoChatDropData(transfer({ ResourceURLs: '{not json', CodeFiles: '42' })), []);
+	});
+
+	test('duplicates are removed across formats', () => {
+		const uris = parseShogoChatDropData(transfer({
+			ResourceURLs: JSON.stringify(['file:///repo/a.ts', 'file:///repo/a.ts']),
+			'text/uri-list': 'file:///repo/a.ts',
+		}));
+		assert.deepStrictEqual(uris, ['file:///repo/a.ts']);
+		assert.deepStrictEqual(mergeShogoChatDropUris(['x', undefined], ['x', 'y']), ['x', 'y']);
+	});
+
+	test('file URIs escape reserved characters', () => {
+		assert.strictEqual(fileUriFromPath('/repo/a#1?.ts'), 'file:///repo/a%231%3F.ts');
+	});
+});
