+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Shogo Technologies, Inc. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+// Shogo: Explorer -> Shogo Chat drag and drop. Kept free of imports so it can be
+// unit-tested outside the workbench (apps/shogo-ide/scripts/__tests__).
+
+/** The Shogo Chat webview view contributed by the bundled shogo-core extension. */
+export const SHOGO_CHAT_VIEW_ID = 'shogo.agentChat';
+
+/** shogo-core command that adds dropped resources to the chat composer. */
+export const SHOGO_ADD_URIS_COMMAND = 'shogo.context.addUris';
+
+/** Class set on the webview container while a resource drag hovers it. */
+export const SHOGO_CHAT_DROP_ACTIVE_CLASS = 'shogo-chat-drop-active';
+
+/**
+ * Mirrors DataTransfers.RESOURCES / CodeDataTransfers.EDITORS / CodeDataTransfers.FILES. Plain OS file drags
+ * (`Files`) are left to the chat webview, which attaches them itself.
+ */
+const RESOURCE_URLS = 'ResourceURLs';
+const CODE_EDITORS = 'CodeEditors';
+const CODE_FILES = 'CodeFiles';
+const URI_LIST = 'text/uri-list';
+
+export const SHOGO_CHAT_RESOURCE_DRAG_TYPES: readonly string[] = [RESOURCE_URLS, CODE_EDITORS, CODE_FILES, URI_LIST];
+
+export interface ShogoDropDataTransfer {
+	readonly types: ArrayLike<string>;
+	getData(format: string): string;
+}
+
+/** True when the drag carries files, folders or editors (not, e.g., a view being moved). */
+export function isShogoChatResourceDrag(types: ArrayLike<string> | null | undefined): boolean {
+	if (!types) {
+		return false;
+	}
+	const list = Array.from(types).map(t => t.toLowerCase());
+	return SHOGO_CHAT_RESOURCE_DRAG_TYPES.some(t => list.includes(t.toLowerCase()));
+}
+
+function readJson(dataTransfer: ShogoDropDataTransfer, format: string): unknown {
+	let raw = '';
+	try {
+		raw = dataTransfer.getData(format);
+	} catch {
+		return undefined;
+	}
+	if (!raw) {
+		return undefined;
+	}
+	try {
+		return JSON.parse(raw);
+	} catch {
+		return undefined;
+	}
+}
+
+/** file:// URI for a filesystem path (POSIX or Windows). */
+export function fileUriFromPath(path: string): string {
+	let p = path.replace(/\\/g, '/');
+	if (!p.startsWith('/')) {
+		p = `/${p}`;
+	}
+	return `file://${encodeURI(p).replace(/#/g, '%23').replace(/\?/g, '%3F')}`;
+}
+
+function uriComponentsToString(value: unknown): string | undefined {
+	if (typeof value === 'string') {
+		return value;
+	}
+	if (!value || typeof value !== 'object') {
+		return undefined;
+	}
+	const c = value as { scheme?: unknown; authority?: unknown; path?: unknown; external?: unknown };
+	if (typeof c.external === 'string') {
+		return c.external;
+	}
+	if (typeof c.scheme !== 'string' || typeof c.path !== 'string') {
+		return undefined;
+	}
+	const authority = typeof c.authority === 'string' ? c.authority : '';
+	return `${c.scheme}://${authority}${encodeURI(c.path)}`;
+}
+
+/** Resource URIs carried by a workbench drag, in order, without duplicates. */
+export function parseShogoChatDropData(dataTransfer: ShogoDropDataTransfer): string[] {
+	const found: string[] = [];
+
+	const resources = readJson(dataTransfer, RESOURCE_URLS);
+	if (Array.isArray(resources)) {
+		for (const entry of resources) {
+			if (typeof entry === 'string' && entry) {
+				found.push(entry);
+			}
+		}
+	}
+
+	const editors = readJson(dataTransfer, CODE_EDITORS);
+	if (Array.isArray(editors)) {
+		for (const editor of editors) {
+			const uri = uriComponentsToString((editor as { resource?: unknown } | null)?.resource);
+			if (uri) {
+				found.push(uri);
+			}
+		}
+	}
+
+	const codeFiles = readJson(dataTransfer, CODE_FILES);
+	if (Array.isArray(codeFiles)) {
+		for (const path of codeFiles) {
+			if (typeof path === 'string' && path) {
+				found.push(fileUriFromPath(path));
+			}
+		}
+	}
+
+	let uriList = '';
+	try {
+		uriList = dataTransfer.getData(URI_LIST);
+	} catch {
+		uriList = '';
+	}
+	for (const line of uriList.split(/\r?\n/)) {
+		const value = line.trim();
+		if (value && !value.startsWith('#')) {
+			found.push(value);
+		}
+	}
+
+	return mergeShogoChatDropUris(found);
+}
+
+/** Concatenate URI lists, dropping empties and duplicates (first occurrence wins). */
+export function mergeShogoChatDropUris(...lists: ReadonlyArray<ReadonlyArray<string | undefined>>): string[] {
+	const seen = new Set<string>();
+	const out: string[] = [];
+	for (const list of lists) {
+		for (const uri of list) {
+			if (!uri || seen.has(uri)) {
+				continue;
+			}
+			seen.add(uri);
+			out.push(uri);
+		}
+	}
+	return out;
+}
