// =============================================================================
// WORKSPACE CHANNELS (team chat with @mentionable agents)
// =============================================================================

model Conversation {
  id              String    @id @default(uuid())
  workspaceId     String
  kind            String    @default("public")
  name            String?
  slug            String?
  topic           String?
  dmKey           String?
  createdById     String?
  lastSeq         Int       @default(0)
  lastMessageAt   DateTime?
  archivedAt      DateTime?
  /// "shogo" for native channels, else the external provider this channel mirrors.
  provider        String    @default("shogo")
  /// Channel / conversation / space id on the external provider.
  externalId      String?
  /// Project whose agent system declares this channel (`teamChannels` in its
  /// shogo-system.yaml). Such a channel can't be deleted — `system_apply` would
  /// recreate it — until the manifest drops it and the next apply clears this.
  systemManagedBy String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace         Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members           ConversationMember[]
  messages          ConversationMessage[]
  attachments       ConversationAttachment[]
  pins              ConversationPin[]
  drafts            ConversationDraft[]
  scheduledMessages ScheduledMessage[]
  huddles           Huddle[]
  doc               ConversationDoc?
  docArchives       ConversationDocArchive[]
  boards            Board[]

  @@unique([workspaceId, slug])
  @@unique([workspaceId, dmKey])
  @@unique([workspaceId, provider, externalId])
  @@index([workspaceId, kind])
  @@map("conversations")
}

/// A live audio call in a conversation. Media runs on LiveKit; this row is the
/// roster and lifecycle. `activeKey` holds the conversation id while the huddle
/// is live and null once it ends, so its unique index allows one live huddle
/// per conversation.
model Huddle {
  id             String    @id @default(uuid())
  workspaceId    String
  conversationId String
  activeKey      String?   @unique
  roomName       String    @unique
  startedById    String
  /// The "started a huddle" system message, updated when the huddle ends.
  messageId      String?
  /// Secret in the shareable join link. Null until someone asks for a link; rotating it revokes old links.
  linkToken      String?   @unique
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  /// Notes (a speaker-labelled transcript and an auto summary) are on for this call. Any participant may turn them off.
  notesEnabled   Boolean   @default(true)
  /// Set when the notes summary was posted, claimed with `updateMany where notesMessageId: null`
  /// so exactly one pod posts it. Holds the summary message id once it is posted.
  notesMessageId String?
  /// Audit: audio seconds the client path actually forwarded to STT for this call.
  notesClientSeconds  Int @default(0)
  /// Audit: audio seconds the LiveKit fallback forwarded to Inference STT for this call.
  notesLivekitSeconds Int @default(0)
  /// When someone last said "hey Shogo" out loud and woke the workspace agent.
  /// Written with a compare-and-set so one wake runs per huddle per 10 s, whatever the pod.
  lastWakeAt DateTime?

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  participants HuddleParticipant[]
  invites      HuddleInvite[]
  joinRequests HuddleJoinRequest[]
  wakes        HuddleWake[]

  @@index([workspaceId, endedAt])
  @@index([conversationId, startedAt])
  @@map("huddles")
}

/// One spoken "hey Shogo" and the agent turn it started. `@@unique([huddleId, itemId])`
/// is the replay guard: a re-sent final can never wake twice. status: running | replied | failed.
model HuddleWake {
  id        String   @id @default(uuid())
  huddleId  String
  /// The person whose words woke it; the turn runs as them, with their permissions.
  speakerId String
  /// The transcript item that carried the phrase, so a replay is recognised.
  itemId    String
  /// The note posted into the huddle's chat, which is the agent's trigger.
  messageId String?
  status    String   @default("running")
  reason    String?
  createdAt DateTime @default(now())

  huddle Huddle @relation(fields: [huddleId], references: [id], onDelete: Cascade)

  @@unique([huddleId, itemId])
  @@index([huddleId, createdAt])
  @@map("huddle_wakes")
}

/// Someone a participant rang into a live huddle. An invite lets the person
/// join the huddle (not the conversation). status: ringing | joined | declined | missed | cancelled.
model HuddleInvite {
  id          String   @id @default(uuid())
  huddleId    String
  userId      String
  invitedById String
  status      String   @default("ringing")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  huddle Huddle @relation(fields: [huddleId], references: [id], onDelete: Cascade)

  @@unique([huddleId, userId])
  @@index([userId, status])
  @@map("huddle_invites")
}

/// Someone who opened the huddle link without access and is waiting to be let in.
/// A workspace member has `userId`; an outside guest has `guestId` and `guestName`.
/// status: waiting | admitted | denied | expired.
model HuddleJoinRequest {
  id         String    @id @default(uuid())
  huddleId   String
  userId     String?
  guestId    String?
  guestName  String?
  status     String    @default("waiting")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  huddle Huddle @relation(fields: [huddleId], references: [id], onDelete: Cascade)

  @@index([huddleId, status])
  @@index([guestId])
  @@map("huddle_join_requests")
}

/// One stay in a huddle. Rejoining after leaving opens a new row.
model HuddleParticipant {
  id       String    @id @default(uuid())
  huddleId String
  userId   String
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  huddle Huddle @relation(fields: [huddleId], references: [id], onDelete: Cascade)

  @@index([huddleId, leftAt])
  @@index([userId])
  @@map("huddle_participants")
}

/// A workspace's install of an external chat app (Slack, Teams, Google Chat).
/// One per workspace and provider; an external tenant maps to one workspace.
model ChatInstallation {
  id                String   @id @default(uuid())
  workspaceId       String
  /// "slack" | "teams" | "google_chat"
  provider          String
  /// Slack team id, Microsoft tenant id, or Google Workspace customer id.
  externalTenantId  String
  tenantName        String?
  botUserId         String?
  /// Encrypted JSON of provider credentials (or a bare encrypted token for installs backfilled from Slack).
  tokensEncrypted   String?
  /// Provider data needed to reply (e.g. Teams serviceUrl).
  config            String?
  installedByUserId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@unique([provider, externalTenantId])
  @@map("chat_installations")
}

/// Links an account on an external chat app to a Shogo user.
model ChatIdentityLink {
  id               String   @id @default(uuid())
  provider         String
  externalTenantId String
  externalUserId   String
  userId           String
  displayName      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalTenantId, externalUserId])
  @@index([userId])
  @@map("chat_identity_links")
}

model ConversationMember {
  id               String    @id @default(uuid())
  conversationId   String
  memberType       String    @default("user")
  userId           String?
  projectId        String?
  projectAgentId   String?
  role             String    @default("member")
  lastReadSeq      Int       @default(0)
  lastReadAt       DateTime?
  notifyLevel      String    @default("default")
  muted            Boolean   @default(false)
  starred          Boolean   @default(false)
  agentTrigger     String    @default("mention")
  agentKeywords    String?
  agentMuted       Boolean   @default(false)
  agentContextMode String    @default("shared")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId, memberType])
  @@map("conversation_members")
}

model ConversationMessage {
  id                String    @id @default(uuid())
  conversationId    String
  workspaceId       String
  seq               Int
  threadRootId      String?
  replyCount        Int       @default(0)
  lastReplyAt       DateTime?
  alsoSentToChannel Boolean   @default(false)
  authorType        String    @default("user")
  authorUserId      String?
  authorAgentRef    String?
  botId             String?
  text              String
  blocks            String?
  clientMsgId       String?
  agentSessionId    String?
  agentStatus       String?
  externalRef       String?
  /// Provider thread id for thread roots whose thread id differs from their message id (Google Chat).
  externalThreadRef String?
  /// { rootMessageId, originUserId, depth, hops, turns, runId?, owner? } for agent @mention chains.
  agentChain        String?
  editedAt          DateTime?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  conversation Conversation                  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorUser   User?                         @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  mentions     ConversationMention[]
  reactions    ConversationReaction[]
  votes        ConversationVote[]
  attachments  ConversationAttachment[]
  pin          ConversationPin?
  savedBy      SavedMessage[]
  embedding    ConversationMessageEmbedding?

  @@unique([conversationId, seq])
  @@unique([conversationId, clientMsgId])
  @@index([conversationId, threadRootId, createdAt])
  @@index([threadRootId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([agentSessionId])
  @@index([externalRef])
  @@index([conversationId, externalThreadRef])
  @@map("conversation_messages")
}

model ConversationMention {
  id             String   @id @default(uuid())
  messageId      String
  targetType     String
  targetUserId   String?
  projectId      String?
  projectAgentId String?
  createdAt      DateTime @default(now())

  message ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([targetUserId, createdAt])
  @@map("conversation_mentions")
}

model ConversationReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("conversation_reactions")
}

/// A vote on a poll option, or an upvote on a question (`optionId` = "up").
model ConversationVote {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  optionId  String
  createdAt DateTime @default(now())

  message ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, optionId])
  @@index([messageId])
  @@map("conversation_votes")
}

model ConversationAttachment {
  id             String   @id @default(uuid())
  conversationId String
  messageId      String?
  /// Null when an agent uploaded the file.
  uploaderUserId String?
  /// "workspace" or "project:<id>" for files an agent posted.
  uploaderAgentRef String?
  storageKey     String
  name           String
  mimeType       String
  size           Int
  width          Int?
  height         Int?
  /// Voice notes only: length of the clip in milliseconds, so a player can
  /// show the total before the audio has loaded.
  durationMs     Int?
  /// Voice notes only: waveform levels, 0-100, space separated. Sampled while
  /// recording because the server cannot decode audio to derive them.
  peaks          String?
  extractedText  String?
  /// Display-ready preview of the file's content (Json? on PG, JSON-encoded here).
  previewData    String?
  createdAt      DateTime @default(now())

  conversation Conversation                  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      ConversationMessage?          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chunks       ConversationAttachmentChunk[]

  @@index([conversationId])
  @@index([messageId])
  @@map("conversation_attachments")
}

/// A slice of a chat file's extracted text, read by agents and ranked by search.
model ConversationAttachmentChunk {
  id             String   @id @default(uuid())
  attachmentId   String
  conversationId String
  workspaceId    String
  idx            Int
  text           String
  charStart      Int
  charEnd        Int
  /// Embedding model, set once the indexer has processed the chunk (even when it produced no vector).
  model          String?
  /// JSON array of numbers.
  embedding      String?
  createdAt      DateTime @default(now())

  attachment ConversationAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@index([attachmentId, idx])
  @@index([conversationId])
  @@index([workspaceId, createdAt])
  @@map("conversation_attachment_chunks")
}

/// Per-workspace chat settings: custom status, Do Not Disturb, and notification defaults.
model ChatUserSettings {
  id              String    @id @default(uuid())
  workspaceId     String
  userId          String
  statusEmoji     String?
  statusText      String?
  statusExpiresAt DateTime?
  dndUntil        DateTime?
  /// Daily quiet hours in `timezone`, as "HH:MM-HH:MM".
  quietHours      String?
  timezone        String?
  /// Channel default when a membership's notifyLevel is "default": "all", "mentions", or "none".
  notifyDefault   String    @default("mentions")
  /// Comma-separated words that notify like a mention.
  keywords        String?
  /// "off" or "daily": email a digest of unread mentions and DMs.
  emailDigest     String    @default("off")
  lastDigestAt    DateTime?
  /// Sound for chat messages: "default", "subtle", or "off".
  messageSound    String    @default("default")
  /// Which sound a chat message plays on web and desktop: "knock", "chirp", "pristine", "definite", "juntos", "confirmation", "question", or "glass".
  messageTone     String    @default("knock")
  /// Sound for incoming huddles: "ring", "chime", or "off".
  huddleSound     String    @default("ring")
  /// Put direct messages in the Activity inbox too.
  dmInActivity         Boolean   @default(false)
  /// Count unread thread replies in the Activity badge.
  threadRepliesInBadge Boolean   @default(true)
  /// When a phone push goes out: "immediate", "inactive", "inactive_5m", or "inactive_10m".
  mobilePushDelay      String    @default("inactive")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([workspaceId, userId])
  @@index([emailDigest])
  @@map("chat_user_settings")
}

model ConversationPin {
  id             String   @id @default(uuid())
  conversationId String
  messageId      String   @unique
  pinnedById     String
  createdAt      DateTime @default(now())

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_pins")
}

/// The channel's single shared markdown document. See schema.prisma.
model ConversationDoc {
  id                 String   @id @default(uuid())
  conversationId     String   @unique
  workspaceId        String
  title              String   @default("")
  content            String   @default("")
  version            Int      @default(1)
  locked             Boolean  @default(false)
  updatedByType      String   @default("user")
  updatedByUserId    String?
  updatedByProjectId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  conversation Conversation              @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  revisions    ConversationDocRevision[]

  @@index([workspaceId])
  @@map("conversation_docs")
}

model ConversationDocRevision {
  id                 String   @id @default(uuid())
  docId              String
  version            Int
  title              String   @default("")
  content            String   @default("")
  updatedByType      String   @default("user")
  updatedByUserId    String?
  updatedByProjectId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  doc ConversationDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId, createdAt])
  @@map("conversation_doc_revisions")
}

/// A section archived out of a ConversationDoc. See schema.prisma.
model ConversationDocArchive {
  id                  String   @id @default(uuid())
  conversationId      String
  workspaceId         String
  title               String   @default("")
  heading             String
  content             String   @default("")
  chars               Int      @default(0)
  archivedByType      String   @default("user")
  archivedByUserId    String?
  archivedByProjectId String?
  createdAt           DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([workspaceId])
  @@map("conversation_doc_archives")
}

model SavedMessage {
  id        String   @id @default(uuid())
  userId    String
  messageId String
  createdAt DateTime @default(now())

  message ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId, createdAt])
  @@map("saved_messages")
}

/// Unsent composer text, synced across devices. `threadRootId` is "" for the channel composer.
model ConversationDraft {
  id             String   @id @default(uuid())
  userId         String
  conversationId String
  threadRootId   String   @default("")
  text           String
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId, threadRootId])
  @@index([userId, updatedAt])
  @@map("conversation_drafts")
}

model ScheduledMessage {
  id                String   @id @default(uuid())
  workspaceId       String
  conversationId    String
  userId            String
  threadRootId      String?
  alsoSentToChannel Boolean  @default(false)
  text              String
  sendAt            DateTime
  /// pending | sent | cancelled | failed
  status            String   @default("pending")
  sentMessageId     String?
  error             String?
  /// Set on a held reply to an agent's question card: the message that asked.
  /// Hidden from the person's scheduled list; its text is rebuilt when it sends.
  questionMessageId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([status, sendAt])
  @@index([userId, status])
  @@index([questionMessageId, userId, status])
  @@map("scheduled_messages")
}

model ChatReminder {
  id             String    @id @default(uuid())
  workspaceId    String
  userId         String
  text           String
  remindAt       DateTime
  messageId      String?
  conversationId String?
  /// pending | fired | done | cancelled
  status         String    @default("pending")
  firedAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, remindAt])
  @@index([userId, status])
  @@map("chat_reminders")
}

/// Activity addressed to one person: mentions, thread replies, reactions, reminders.
model ChatInboxItem {
  id             String    @id @default(uuid())
  workspaceId    String
  userId         String
  /// mention | dm | thread | reaction | reminder | keyword | broadcast | message | question
  kind           String
  conversationId String?
  messageId      String?
  actorUserId    String?
  title          String
  preview        String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, workspaceId, createdAt])
  @@index([userId, readAt])
  @@index([messageId])
  @@map("chat_inbox_items")
}

model CustomEmoji {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  storageKey  String
  mimeType    String
  createdById String
  createdAt   DateTime @default(now())

  @@unique([workspaceId, name])
  @@map("custom_emoji")
}

/// A mentionable set of people, e.g. @design.
model UserGroup {
  id          String   @id @default(uuid())
  workspaceId String
  handle      String
  name        String
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members UserGroupMember[]

  @@unique([workspaceId, handle])
  @@map("user_groups")
}

model UserGroupMember {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("user_group_members")
}

model ConversationMessageEmbedding {
  id          String   @id @default(uuid())
  messageId   String   @unique
  workspaceId String
  model       String
  embedding   String
  createdAt   DateTime @default(now())

  message ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("conversation_message_embeddings")
}

// =============================================================================
// WORK BOARDS
// =============================================================================

/// A Kanban board. A channel can hold several; boards with no channel are
/// workspace-level. `managedBy: "manifest"` boards are declared in a project's
/// shogo-system.yaml (`teamChannels[].boards`) and owned by `system_apply`.
model Board {
  id                      String    @id @default(uuid())
  workspaceId             String
  conversationId          String?
  name                    String
  slug                    String
  /// Prefix for card keys, e.g. "SUP" for SUP-42.
  keyPrefix               String
  /// Last card number handed out; card numbers stay with the card when it moves.
  itemCounter             Int       @default(0)
  /// Tab order within the channel.
  position                Int       @default(0)
  /// task | problem | ticket | deal | candidate | approval | content | custom
  itemType                String    @default("task")
  description             String?
  /// Card field definitions: [{ key, label, type, options?, required? }].
  fieldsSchema            String?
  /// all | done_only | none — which card events post to the channel.
  postToChannel           String    @default("all")
  requiresHumanReview     Boolean   @default(false)
  /// "workspace" or "project:<id>".
  defaultAssigneeAgentRef String?
  /// user | manifest
  managedBy               String    @default("user")
  /// Project whose shogo-system.yaml declares this board.
  systemManagedBy         String?
  templateId              String?
  createdById             String?
  archivedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  columns      BoardColumn[]
  items        WorkItem[]

  @@unique([workspaceId, slug])
  @@index([conversationId, position])
  @@map("boards")
}

model BoardColumn {
  id        String   @id @default(uuid())
  boardId   String
  name      String
  position  Int      @default(0)
  /// backlog | active | waiting | review | done | dismissed
  category  String   @default("active")
  wipLimit  Int?
  /// Agent that picks up cards moved here: "workspace" or "project:<id>".
  agentRef  String?
  /// Cards older than this in the column count as breaching SLA.
  slaHours  Float?
  /// Per-column rules. `allowAutoMerge` is the only key today: a card's PR may
  /// only be armed / merged by an agent from a column that allows it.
  rules     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  items WorkItem[]

  @@index([boardId, position])
  @@map("board_columns")
}

/// A card. Its conversation lives in a thread in the board's channel
/// (`conversationId` + `threadRootMessageId`); everything else it touches is
/// recorded as a WorkItemLink.
model WorkItem {
  id                  String    @id @default(uuid())
  workspaceId         String
  boardId             String
  columnId            String
  /// Sort order inside the column.
  position            Float     @default(0)
  /// e.g. "SUP-42". Unique in the workspace and kept across board moves.
  key                 String
  number              Int
  title               String
  description         String?
  fields              String?
  /// urgent | high | medium | low | none
  priority            String    @default("none")
  assigneeUserId      String?
  /// "workspace" or "project:<id>".
  assigneeAgentRef    String?
  dueAt               DateTime?
  goalId              String?
  projectId           String?
  conversationId      String?
  threadRootMessageId String?
  /// manual | message | trigger | agent | api | problem
  source              String    @default("manual")
  externalRef         String?
  eventSubscriptionId String?
  /// Dedupe key for trigger and problem intake.
  fingerprint         String?
  /// Rolling summary of the card's whole history, for agent context.
  historySummary      String?
  historySummaryAt    DateTime?
  createdById         String?
  createdByAgentRef   String?
  /// When the card entered its current column (drives SLA and staleness).
  columnEnteredAt     DateTime  @default(now())
  lastActivityAt      DateTime  @default(now())
  completedAt         DateTime?
  archivedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  board         Board                  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column        BoardColumn            @relation(fields: [columnId], references: [id], onDelete: Cascade)
  events        WorkItemEvent[]
  links         WorkItemLink[]
  subscriptions WorkItemSubscription[]
  occurrences   ProblemOccurrence[]

  @@unique([workspaceId, key])
  @@index([boardId, columnId, position])
  @@index([workspaceId, assigneeUserId])
  @@index([workspaceId, assigneeAgentRef])
  @@index([workspaceId, fingerprint])
  @@index([threadRootMessageId])
  @@map("work_items")
}

model WorkItemEvent {
  id            String   @id @default(uuid())
  workItemId    String
  workspaceId   String
  /// created | updated | moved | assigned | commented | linked | archived | restored | regressed | occurrence
  type          String
  actorUserId   String?
  actorAgentRef String?
  /// Chat session that made the change, when an agent did.
  sessionId     String?
  eventData     String?
  createdAt     DateTime @default(now())

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@index([workItemId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("work_item_events")
}

/// A conversation a card has been part of, beyond its own thread.
model WorkItemLink {
  id              String   @id @default(uuid())
  workItemId      String
  workspaceId     String
  /// message | thread | chat_session | agent_task | external_thread | pr | doc
  kind            String
  refId           String
  conversationId  String?
  /// origin | mention | agent_run | tool_call | escalation | manual | sync
  reason          String
  addedByUserId   String?
  addedByAgentRef String?
  snippet         String?
  url             String?
  /// Live state of the linked PR (JSON on SQLite) — see schema.prisma.
  metadata        String?
  /// When `metadata` was last read from the source (null = never).
  syncedAt        DateTime?
  createdAt       DateTime @default(now())

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([workItemId, kind, refId])
  @@index([kind, refId])
  @@map("work_item_links")
}

model WorkItemSubscription {
  id         String   @id @default(uuid())
  workItemId String
  userId     String
  createdAt  DateTime @default(now())

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([workItemId, userId])
  @@index([userId])
  @@map("work_item_subscriptions")
}

/// One sighting of the error behind a `problem` card.
model ProblemOccurrence {
  id                String   @id @default(uuid())
  workItemId        String
  workspaceId       String
  fingerprint       String
  environment       String?
  release           String?
  message           String?
  stack             String?
  url               String?
  userRef           String?
  occurrenceContext String?
  occurredAt        DateTime @default(now())

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@index([workItemId, occurredAt])
  @@index([workspaceId, fingerprint])
  @@map("problem_occurrences")
}

// ─── Social management (Zernio) — SQLite mirror of prisma/schema.prisma ──────
// Json? columns are stored as JSON strings; String[] as JSON-encoded String.

model SocialProfile {
  id               String   @id @default(uuid())
  workspaceId      String
  localWorkspaceId String   @default("")
  zernioProfileId  String   @unique
  externalId       String   @unique
  name             String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accounts  SocialAccount[]

  @@unique([workspaceId, localWorkspaceId])
  @@map("social_profiles")
}

model SocialAccount {
  id              String    @id @default(uuid())
  workspaceId     String
  profileId       String
  zernioAccountId String    @unique
  platform        String
  username        String
  displayName     String?
  isActive        Boolean   @default(true)
  tokenHealthy    Boolean   @default(true)
  needsReconnect  Boolean   @default(false)
  lastHealthAt    DateTime?
  /// Watermark for the `social_account_monthly` meter: the month this row has
  /// already been charged for. Zernio bills per connected account, prorated by
  /// active days, so the sweep charges once per account per month.
  monthlyRateDebitedFor DateTime?
  connectedAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile   SocialProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  targets   SocialPostTarget[]
  conversations SocialConversation[]
  comments  SocialComment[]
  automations SocialAutomation[]

  @@unique([workspaceId, platform, username])
  @@index([workspaceId, platform])
  @@map("social_accounts")
}

model SocialPost {
  id              String    @id @default(uuid())
  workspaceId     String
  status          String    @default("draft")
  content         String
  mediaJson       String?
  scheduledFor    DateTime?
  publishedAt     DateTime?
  zernioPostId    String?
  idempotencyKey  String    @unique
  createdByUserId String?
  tags            String    @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  targets   SocialPostTarget[]
  comments  SocialComment[]

  @@index([workspaceId, scheduledFor])
  @@index([workspaceId, status])
  @@map("social_posts")
}

model SocialPostTarget {
  id              String   @id @default(uuid())
  postId          String
  accountId       String
  platform        String
  customContent   String?
  mediaJson       String?
  status          String   @default("pending")
  platformPostId  String?
  platformPostUrl String?
  error           String?
  /// Set once the `social_x_api` meter has charged this leg, so a retried
  /// dispatch cannot bill the same published post twice. Null on every
  /// non-X platform, which Zernio does not bill per post.
  meteredAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  post    SocialPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([postId, accountId])
  @@index([accountId, status])
  @@map("social_post_targets")
}

/// A verified webhook that belongs to a desktop's local scope, written down
/// before we answer the provider. A desktop polls the cloud relay for these,
/// applies each in its own DB and acks it; `dedupeKey` makes a provider retry
/// collapse onto the row that already exists.
model SocialRelayedEvent {
  id               String    @id @default(uuid())
  dedupeKey        String    @unique
  workspaceId      String
  localWorkspaceId String
  externalId       String
  eventType        String
  /// JSON-encoded envelope the desktop replays through `applySocialEvent`.
  /// Deliberately not `payload`: that name is globally JSON-coerced by the
  /// SQLite client for `WorkspaceEvent.payload`.
  eventJson        String
  occurredAt       DateTime  @default(now())
  appliedAt        DateTime?
  /// Failed apply attempts. A delivery whose payload we cannot apply is retried
  /// rather than acked away, but not forever: past the attempt cap it is
  /// dead-lettered (`failedAt`) so a poison event cannot loop.
  attempts         Int       @default(0)
  lastAttemptAt    DateTime?
  lastError        String?
  failedAt         DateTime?
  createdAt        DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, localWorkspaceId, appliedAt])
  @@index([workspaceId, failedAt])
  @@map("social_relayed_events")
}

/// One inbox thread — a DM conversation on a messaging platform. Written by
/// the provider's webhooks and by the backfill sweep, never by polling the
/// provider for each render.
model SocialConversation {
  id                   String    @id @default(uuid())
  workspaceId          String
  accountId            String?
  zernioConversationId String    @unique
  platform             String
  participantId        String?
  participantName      String?
  participantPicture   String?
  status               String    @default("active")
  unreadCount          Int       @default(0)
  lastReadAt           DateTime?
  lastMessageAt        DateTime?
  lastMessagePreview   String?
  assignedToUserId     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   SocialAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  messages  SocialMessage[]

  @@index([workspaceId, lastMessageAt])
  @@index([workspaceId, unreadCount])
  @@index([workspaceId, platform])
  @@map("social_conversations")
}

/// One message inside a thread. Unique on the provider's message id, so a
/// redelivered webhook and a backfill sweep that overlaps it are the same row.
model SocialMessage {
  id              String   @id @default(uuid())
  workspaceId     String
  conversationId  String
  zernioMessageId String   @unique
  direction       String
  platform        String
  text            String?
  attachmentsJson String?
  authorId        String?
  authorName      String?
  authorUsername  String?
  authorPicture   String?
  status          String   @default("sent")
  error           String?
  /// True once a billable outbound message has been counted (P6's `social_dm`
  /// meter flips this; the reply path records the row and leaves it false).
  metered         Boolean  @default(false)
  sentAt          DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation SocialConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
  @@index([workspaceId, sentAt])
  @@map("social_messages")
}

/// One comment on a post we published (or on a post the account owns that
/// Zernio tracks). Separate from messages on purpose: comments are answered
/// publicly and addressed by their own ids.
model SocialComment {
  id              String    @id @default(uuid())
  workspaceId     String
  postId          String?
  accountId       String?
  zernioCommentId String    @unique
  /// What `POST /inbox/comments/{postId}` takes: Zernio's post id when the
  /// payload carries one, else the platform's own post id.
  zernioPostId    String
  platformPostId  String
  platform        String
  text            String
  authorId        String?
  authorName      String?
  authorUsername  String?
  authorPicture   String?
  /// The connected account wrote this — the platform echoes our own replies
  /// back as comment events.
  isOwn           Boolean   @default(false)
  isHidden        Boolean   @default(false)
  status          String    @default("new")
  repliedAt       DateTime?
  permalink       String?
  occurredAt      DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  post      SocialPost?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  account   SocialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([workspaceId, occurredAt])
  @@index([workspaceId, status])
  @@index([zernioPostId])
  @@map("social_comments")
}

/// A ManyChat-style automation the workspace runs on one connected account.
///
/// Zernio owns the execution: a `comment_dm`/`keyword_reply` row mirrors a
/// comment automation (`POST /v1/comment-automations`), and a `sequence` row
/// mirrors a workflow graph (`POST /v1/workflows`). This table is what we bill,
/// count and show — never a second scheduler. `runCount`/`lastRunAt` are moved
/// by the automation webhooks, not by a sweep.
model SocialAutomation {
  id               String    @id @default(uuid())
  workspaceId      String
  accountId        String?
  /// comment_dm | keyword_reply | sequence
  kind             String    @default("comment_dm")
  /// The provider's own id: a comment automation id or a workflow id.
  zernioResourceId String?   @unique
  platform         String
  name             String
  /// static (fixed copy) | agent (the agent writes the DM)
  mode             String    @default("static")
  /// draft | active | paused
  status           String    @default("active")
  /// JSON-encoded string[]: SQLite has no list type.
  keywords         String    @default("[]")
  /// The provider request this row mirrors, so a later edit can be replayed.
  config           Json?
  runCount         Int       @default(0)
  lastRunAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   SocialAccount?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  runs      SocialAutomationRun[]

  @@index([workspaceId, status])
  @@index([workspaceId, kind])
  @@map("social_automations")
}

/// One execution of an automation, from the provider's own run webhooks.
///
/// A row per execution (not a counter on the automation) is what lets analytics
/// answer "how many runs in this range" honestly; the provider's execution id is
/// globally unique, so a redelivered `workflow.run.completed` collapses onto the
/// same row instead of inflating the count.
model SocialAutomationRun {
  id                String    @id @default(uuid())
  workspaceId       String
  automationId      String?
  zernioExecutionId String    @unique
  /// running | completed | exited | failed
  status            String    @default("running")
  error             String?
  startedAt         DateTime  @default(now())
  endedAt           DateTime?
  createdAt         DateTime  @default(now())

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation SocialAutomation? @relation(fields: [automationId], references: [id], onDelete: SetNull)

  @@index([workspaceId, startedAt])
  @@index([automationId])
  @@map("social_automation_runs")
}

// ─── Machine workspaces (SHO-185) ───────────────────────────────────────────
// Cloud-side copy bookkeeping, kept in the desktop schema too because the two
// must stay identical (check-schema-parity). The desktop only ever writes
// `machine_sync_changes`.

model MachineSyncState {
  instanceId   String    @id
  epoch        String    @default("")
  cursor       Int       @default(0)
  lastIngestAt DateTime?
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("machine_sync_states")
}

model MachineMirrorRow {
  model      String
  recordId   String
  instanceId String
  epoch      String   @default("")
  createdAt  DateTime @default(now())

  @@id([model, recordId])
  @@index([instanceId])
  @@index([instanceId, model])
  @@map("machine_mirror_rows")
}

/// The desktop's own change log. SQLite triggers write here, the pusher reads
/// it and advances `MachineSyncState.cursor` as the cloud acks.
model MachineSyncChange {
  seq       Int      @id @default(autoincrement())
  model     String
  recordId  String
  op        String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("machine_sync_changes")
}
