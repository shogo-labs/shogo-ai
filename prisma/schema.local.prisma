// =============================================================================
// STUDIO-CHAT (Chat Sessions & Messages)
// =============================================================================

model ChatSession {
  id                    String    @id @default(uuid())
  name                  String?
  inferredName          String
  // Allowed values mirror schema.prisma ContextType: feature, project,
  // general, workspace. SQLite has no enum support so we store the string.
  contextType           String
  contextId             String?
  // Set only for contextType == workspace (see schema.prisma).
  workspaceId           String?
  // Owner of a personal workspace-agent chat. Null for project chats,
  // scheduled/DM/Slack sessions, and chats created before ownership existed.
  createdByUserId       String?
  phase                 String?
  claudeCodeSessionId   String?
  cachedMessageCount    Int       @default(0)
  contextUsageTokens    Int       @default(0)
  contextWindowTokens   Int       @default(0)
  // Durable summary of everything up to `contextSummaryThroughCount` messages
  // (see schema.prisma — kept in the DB, not the runtime's sessions.db, so an
  // evicted session cannot take it with it; SHO-137).
  contextSummary              String?
  contextSummaryThroughCount  Int       @default(0)
  isPrimary             Boolean   @default(false)
  isPinned              Boolean   @default(false)
  isArchived            Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt
  lastActiveAt          DateTime  @default(now())
  // Set while an agent turn is in flight. The turn id makes completion
  // updates conditional so an older stream cannot clear a newer turn.
  // The heartbeat is refreshed while the stream runs; activity treats a
  // turn with an old heartbeat as dead (e.g. the API restarted mid-turn).
  activeTurnId          String?
  activeTurnStartedAt   DateTime?
  activeTurnHeartbeatAt DateTime?

  // BETA: per-chat git worktrees (mirrors schema.prisma). null when off.
  worktreeBranch String?
  // active | merging | merged
  worktreeStatus String?
  worktreePath   String?

  project          Project?             @relation(fields: [contextId], references: [id], onDelete: Cascade)
  workspace        Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  attachedProjects ChatSessionProject[]
  messages         ChatMessage[]
  queuedMessages   ChatQueuedMessage[]
  toolCallLogs     ToolCallLog[]
  agentTasks       AgentTask[]
  plans            Plan[]

  @@index([contextType, contextId])
  @@index([workspaceId])
  @@index([workspaceId, createdByUserId, lastActiveAt])
  @@index([activeTurnHeartbeatAt])
  @@map("chat_sessions")
}

model Plan {
  id            String   @id @default(uuid())
  workspaceId   String?
  projectId     String?
  chatSessionId String?
  runtimeKey    String?
  filename      String
  name          String
  overview      String   @default("")
  status        String   @default("pending")
  content       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace   Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chatSession ChatSession? @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)

  @@unique([projectId, filename])
  @@index([workspaceId])
  @@index([projectId])
  @@index([chatSessionId])
  @@index([updatedAt])
  @@map("plans")
}

/// Projects attached to a workspace-scoped ChatSession (see schema.prisma).
model ChatSessionProject {
  id         String   @id @default(uuid())
  sessionId  String
  projectId  String
  attachMode String   @default("readwrite")
  createdAt  DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([sessionId, projectId])
  @@index([projectId])
  @@map("chat_session_projects")
}

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String
  role      String
  content   String
  imageData String?
  parts     String?
  createdAt DateTime @default(now())
  /// Which agent authored this row. "technical" (default, legacy rows) or
  /// "voice" (EZ Mode translator overlay thread).
  agent     String   @default("technical")
  /// Model selection (picker `agentMode` value) used to author this row.
  /// Stamped on assistant messages; null for legacy rows.
  model     String?

  session  ChatSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  feedback MessageFeedback[]

  @@index([sessionId])
  @@index([sessionId, createdAt])
  @@index([sessionId, agent, createdAt])
  @@map("chat_messages")
}

/// A prompt submitted while another turn is active. Queue rows are durable so
/// the local API can dispatch them after the client disconnects or restarts.
model ChatQueuedMessage {
  id        String   @id @default(uuid())
  sessionId String
  userId    String
  position  Int      @default(0)
  status    String   @default("pending")
  content   String
  parts     String?
  body      String
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  /// "user" for prompts; "task_notification" for a wake after background tasks finished.
  kind      String   @default("user")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status, position])
  @@index([sessionId, createdAt])
  @@map("chat_queued_messages")
}

/// Async work an agent session can wait on or be woken by. The runtime keeps
/// its own tasks (shell, subagents) in memory; rows here are the ones the API
/// observes (a project call, a tagged agent's reply, a card) plus local tasks
/// the runtime handed over to wake an idle session. `consumed` means the agent
/// already saw the result, so no wake is sent for it.
model BackgroundTask {
  id            String    @id
  chatSessionId String
  /// project_call | agent_reply | work_item | shell | subagent
  source        String
  /// What events match: `projectId:runId`, `triggerMessageId:projectId|ws`, a work item id.
  targetRef     String
  title         String
  /// running | completed | failed | cancelled
  status        String    @default("running")
  output        String    @default("")
  summary       String?
  /// Regex that completes the task when its output matches (cards).
  until         String?
  /// Notification text for a wake, when the runtime formatted it.
  note          String?
  notify        Boolean   @default(true)
  consumed      Boolean   @default(false)
  /// Set when a wake claims this row; cleared again if that wake never ran, so
  /// the drain sweep can re-queue it.
  notifiedAt    DateTime?
  /// How many wakes claimed this row and had to be released.
  attempts      Int       @default(0)
  /// Earliest time the sweep may re-queue it, so a broken wake cannot hot-loop.
  nextAttemptAt DateTime?
  /// A finished card watch waits while agents are still working the card's
  /// thread; its wake goes out when the thread goes quiet or at this time.
  heldUntil     DateTime?
  /// Where the task's work is happening, so the chat dock can open that thread
  /// instead of an empty log: channel thread, card, project session, subagent.
  /// (SQLite has no Json: JSON-encoded here.)
  link          String?
  finishedAt    DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([source, targetRef, status])
  @@index([chatSessionId, status])
  @@index([expiresAt])
  @@index([notify, consumed, notifiedAt])
  @@map("background_tasks")
}

/// A wake that arrived while the agent already had a live run in that thread.
/// One live run per (agent, thread): the loser of the reservation writes a row
/// here, is acknowledged in the thread, and runs when the live reply ends.
/// `status` runs pending → claimed → done | failed; the drain sweep picks up a
/// pending row left behind by an API restart (nothing else would run it).
model AgentWake {
  id               String    @id @default(uuid())
  workspaceId      String
  conversationId   String
  threadRootId     String?
  /// The message that woke the agent: one wake per (trigger, agent).
  triggerMessageId String
  /// `project:<id>` or `workspace`, as boards and mentions name an agent.
  agentRef         String
  /// Who the drain runs the wake for (billing and the chain's origin).
  userId           String
  /// Chain state to resume with, so a queued hand-off keeps its place.
  /// (SQLite has no Json: JSON-encoded here.)
  chain            String?
  /// Why the row exists: `wake` (behind a live run) or `move_nudge` (a move
  /// into a column that binds no agent — a hint, debounced by `notBefore`, that
  /// the tag following it supersedes).
  reason           String    @default("wake")
  /// Earliest time the drain may start this row. Null runs as soon as it can.
  notBefore        DateTime?
  /// The chat session the live run held, so the session's queue dock finds
  /// this row and can send it now from there.
  chatSessionId    String?
  /// The system note that says it is queued, so its status can follow the row.
  noteMessageId    String?
  /// Set when a person presses Send now: the drain takes the newest first, the
  /// way the chat queue's send-now marks a row ahead of the rest.
  sendNowAt        DateTime?
  /// pending | claimed | done | failed | superseded
  status           String    @default("pending")
  attempts         Int       @default(0)
  claimedAt        DateTime?
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  @@unique([triggerMessageId, agentRef])
  @@index([conversationId, threadRootId, agentRef, status])
  @@index([status, createdAt])
  @@index([status, notBefore])
  @@index([chatSessionId, status])
  @@map("agent_wakes")
}

/// A user's thumbs up/down reaction to one assistant `ChatMessage` (one
/// completed turn). Powers the footer feedback buttons under each
/// assistant turn in the mobile/web chat UI. One row per (messageId,
/// userId) — re-tapping the same thumb clears it (DELETE), tapping the
/// other thumb flips it (upsert), matching a typical single-reaction
/// feedback widget rather than a tally-style vote count.
model MessageFeedback {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  /// "up" | "down"
  thumbs    String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@map("message_feedback")
}

model ToolCallLog {
  id            String   @id @default(uuid())
  chatSessionId String
  messageId     String
  toolName      String
  status        String
  args          String?
  result        String?
  duration      Int?
  userId        String?
  linesAdded    Int      @default(0)
  linesRemoved  Int      @default(0)
  createdAt     DateTime @default(now())

