// Shogo AI - SQLite Prisma Schema (Local/Desktop Mode)
//
// This schema mirrors schema.prisma but targets SQLite for local mode.
// Key differences from the PostgreSQL schema:
// - provider = "sqlite"
// - String[] fields → String (JSON-encoded arrays)
// - @db.Text annotations removed (SQLite TEXT is the default)
//
// Generate with: bunx prisma generate --schema=prisma/schema.local.prisma
// Migrate with:  bunx prisma migrate dev --schema=prisma/schema.local.prisma

generator client {
  provider        = "prisma-client"
  output          = "../apps/api/src/generated/prisma-sqlite"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "sqlite"
}

// =============================================================================
// BETTER-AUTH (Authentication)
// =============================================================================

model User {
  id                          String   @id @default(cuid())
  name                        String?
  email                       String   @unique
  emailVerified               Boolean  @default(false)
  image                       String?
  role                        String   @default("user")
  // See prisma/schema.prisma for the canonical comment. SQLite has no native
  // String[] so adminScopes is stored as JSON-encoded TEXT (`["analytics:read"]`).
  adminScopes                 String   @default("[]")
  onboardingCompleted         Boolean  @default(false)
  lastSeenAnnouncementVersion String?
  onboardingIntent            String?
  buddyLook                   String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  sessions                   Session[]
  accounts                   Account[]
  members                    Member[]
  notifications              Notification[]
  agentTasks                 AgentTask[]
  agentSchedules             AgentSchedule[]
  starredProjects            StarredProject[]
  apiKeys                    ApiKey[]
  creatorProfile             CreatorProfile?
  signupAttribution          SignupAttribution?
  creatorFollows             CreatorFollow[]                 @relation("UserFollows")
  affiliate                  Affiliate?
  affiliateAttribution       AffiliateAttribution?
  projectAuthSignIns         ProjectAuthSignIn[]
  mobilePushSubscriptions    MobilePushSubscription[]
  appInstalls                AppInstall[]
  slackUserLinks             SlackUserLink[]
  chatIdentityLinks          ChatIdentityLink[]
  conversationMemberships    ConversationMember[]
  conversationMessages       ConversationMessage[]
  integrationConnections     UserIntegrationConnection[]
  integrationGrants          UserIntegrationGrant[]
  integrationWorkspaceGrants UserIntegrationWorkspaceGrant[]
  identityLinks              UserIdentityLink[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// =============================================================================
// STUDIO-CORE (Multi-tenancy & Project Management)
// =============================================================================

model Workspace {
  id                String   @id @default(uuid())
  name              String
  kind              String   @default("team")
  slug              String   @unique
  description       String?
  ssoSettings       String?
  // The workspace agent's own settings (capability toggles and anything else
  // it owns). Distinct from any project's `settings`: a workspace runtime
  // serves both surfaces, and a toggle made in a workspace chat must land
  // here, not on whichever project the user last opened. JSON stored as TEXT
  // on SQLite (see `apps/api/src/lib/workspace-settings.ts`).
  settings          String?
  instanceSize      String   @default("micro")
  // See packages/agent-runtime/src/composio.ts and
  // apps/api/src/routes/integrations.ts. New workspaces default to
  // "workspace" (one OAuth shared across the workspace); existing
  // workspaces are migrated to "project" to preserve current behavior.
  composioScope     String   @default("workspace")
  // Whether proxy requests and responses may be retained for product
  // analysis and training. "default" and "enabled" both capture (on for
  // every plan, including enterprise); only "disabled" opts the workspace out.
  trainingDataMode  String   @default("default")
  // Optional parent workspace. When set, this workspace is a "child" that
  // pools the parent's plan, usage wallet, and seats (no subscription/wallet
  // of its own). Only Business/Enterprise workspaces may have children.
  parentWorkspaceId String?
  // Team chat surface: "off" | "native" | "external" | "bridged". Null means
  // the default for the workspace kind (native for team, off for personal).
  chatMode          String?
  // External chat provider for "external" / "bridged": "slack" | "teams" | "google_chat".
  chatProvider      String?
  // How many agent replies may be *working at once* in this workspace, or null
  // for the maximum the plan (or local mode) allows. An admin can lower it; the
  // plan value is the ceiling in the cloud (see `agent-reply-capacity.ts`).
  agentReplyConcurrency Int?
  // Set when this workspace is a copy of a paired desktop's workspace: the
  // machine's id. The cloud holds the records (copied into the normal tables
  // with their desktop ids), serves reads from them, and refuses its own writes
  // to them — see `lib/machine-workspace.ts`. Null means a normal cloud
  // workspace. Added to both schemas; the desktop leaves it null.
  machineInstanceId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  parent                 Workspace?                      @relation("WorkspaceHierarchy", fields: [parentWorkspaceId], references: [id], onDelete: SetNull)
  children               Workspace[]                     @relation("WorkspaceHierarchy")
  projects               Project[]
  members                Member[]
  billingAccounts        BillingAccount[]
  invitations            Invitation[]
  inviteLinks            InviteLink[]
  folders                Folder[]
  subscriptions          Subscription[]
  instanceSubscription   InstanceSubscription?
  usageWallets           UsageWallet[]
  usageEvents            UsageEvent[]
  liveSessionMeters      LiveSessionMeter[]
  storageUsage           StorageUsage?
  starredProjects        StarredProject[]
  integrationGrants      UserIntegrationWorkspaceGrant[]
  agentTasks             AgentTask[]
  agentSchedules         AgentSchedule[]
  workspaceEvents        WorkspaceEvent[]
  eventSubscriptions     EventSubscription[]
  instances              Instance[]
  apiKeys                ApiKey[]
  meetings               Meeting[]
  meetingTemplates       MeetingTemplate[]
  voiceProjectConfigs    VoiceProjectConfig[]
  projectAgents          ProjectAgent[]
  agentCostMetrics       AgentCostMetric[]
  budgetAlerts           BudgetAlert[]
  modelExperiments       ModelExperiment[]
  subagentModelOverrides SubagentModelOverride[]
  agentEvalResults       AgentEvalResult[]
  agentEvalSets          AgentEvalSet[]
  grants                 WorkspaceGrant[]
  chatSessions           ChatSession[]
  proxyTurns             ProxyTurn[]
  conversations          Conversation[]
  chatInstallations      ChatInstallation[]
  boards                 Board[]
  workItems              WorkItem[]
  plans                  Plan[]
  modelVisibility        WorkspaceModelVisibility[]
  slackInstallation      SlackWorkspaceInstallation?
  agentProfile           WorkspaceAgentProfile?
  goals                  Goal[]
  socialProfiles         SocialProfile[]
  socialAccounts         SocialAccount[]
  socialPosts            SocialPost[]
  socialRelayedEvents    SocialRelayedEvent[]
  socialConversations    SocialConversation[]
  socialMessages         SocialMessage[]
  socialComments         SocialComment[]
  socialAutomations      SocialAutomation[]
  socialAutomationRuns   SocialAutomationRun[]

  @@index([parentWorkspaceId])
  @@index([machineInstanceId])
  @@map("workspaces")
}

model ProxyTurn {
  id                String    @id @default(uuid())
  firstAt           DateTime  @default(now())
  lastAt            DateTime  @default(now())
  source            String
  workspaceId       String
  projectId         String?
  userId            String?
  chatSessionId     String?
  turnKey           String
  resolvedModel     String?
  llmCalls          Int       @default(0)
  inputTokens       Int       @default(0)
  outputTokens      Int       @default(0)
  cachedInputTokens Int       @default(0)
  cacheWriteTokens  Int       @default(0)
  reasoningTokens   Int       @default(0)
  errorCount        Int       @default(0)
  userText          String?
  assistantText     String?
  toolNames         String    @default("[]")
  archivePrefix     String?
  feedback          String?
  revertedAt        DateTime?
  hadError          Boolean   @default(false)
  truncated         Boolean   @default(false)
  userFollowupKind  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, turnKey])
  @@index([workspaceId, lastAt])
  @@index([chatSessionId, lastAt])
  @@map("proxy_turns")
}

model WorkspaceAgentProfile {
  id              String    @id @default(uuid())
  workspaceId     String    @unique
  name            String    @default("Shogo")
  avatarUrl       String?
  // JSON-encoded Shogo buddy look (see packages/shared-app/src/buddy-look.ts); null = the default look.
  buddyLook       String?
  tagline         String?
  personality     String?
  statusText      String?
  statusUpdatedAt DateTime?
  // Model used when the agent is tagged in a channel or thread; null = Auto. Set by workspace admins.
  defaultModel    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_agent_profiles")
}

model Goal {
  id             String    @id @default(uuid())
  workspaceId    String
  title          String
  why            String?
  status         String    @default("active")
  plan           String    @default("[]")
  deliverables   String    @default("[]")
  nextCheckInAt  DateTime?
  lastProgressAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events     GoalEvent[]
  agentTasks AgentTask[]
  schedules  AgentSchedule[]

  @@index([workspaceId, status])
  @@index([workspaceId, updatedAt])
  @@map("goals")
}

model AgentSchedule {
  id                   String    @id @default(uuid())
  workspaceId          String
  goalId               String?
  userId               String
  name                 String
  prompt               String
  cronExpression       String
  timezone             String    @default("UTC")
  enabled              Boolean   @default(true)
  nextRunAt            DateTime
  lastRunAt            DateTime?
  lastRunStatus        String?
  lastRunSummary       String?
  lastError            String?
  chatSessionId        String?
  notifyConversationId String?
  notifyThreadRootId   String?
  runningAt            DateTime?
  consecutiveFailures  Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goal      Goal?     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enabled, nextRunAt])
  @@index([workspaceId])
  @@index([goalId])
  @@index([userId])
  @@map("agent_schedules")
}

// SQLite: Json → String (JSON-encoded via wrapForSqlite).
model WorkspaceEvent {
  id          String   @id @default(uuid())
  workspaceId String
  type        String
  version     Int      @default(1)
  source      String   @default("shogo")
  payload     String
  dedupeKey   String
  actor       String?
  occurredAt  DateTime @default(now())

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries EventDelivery[]

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, occurredAt])
  @@map("workspace_events")
}

model EventSubscription {
  id           String  @id @default(uuid())
  workspaceId  String
  name         String
  enabled      Boolean @default(true)
  eventType    String
  eventVersion Int     @default(1)
  filter       String?
  ownerUserId  String?
  /// "user", or "app" for subscriptions an app install owns (see AppInstallGrant).
  ownerKind    String  @default("user")
  installId    String?

  source                     String  @default("shogo")
  composioTriggerSlug        String?
  composioTriggerId          String? @unique
  composioConnectedAccountId String?
  composioEntityId           String?
  triggerConfig              String?

  actsAs          String  @default("subscriber")
  actorIdPath     String?
  actorEmailPath  String?
  trustActorEmail Boolean @default(false)

  target               String  @default("agent")
  targetProjectId      String?
  targetMode           String?
  prompt               String?
  notifyConversationId String?
  notifyThreadRootId   String?
  /// For `work_item` targets: { boardId, columnId?, mapping, dedupeKey? }.
  workItemTarget       String?
  webhookUrl           String?
  webhookSecret        String?

  chatSessionId       String?
  consecutiveFailures Int       @default(0)
  lastDeliveredAt     DateTime?
  lastError           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries EventDelivery[]

  @@index([workspaceId, enabled, eventType])
  @@index([ownerUserId])
  @@index([installId])
  @@map("event_subscriptions")
}

/// What a marketplace app install may access, consented by the installer.
model AppInstallGrant {
  id              String    @id @default(cuid())
  installId       String    @unique
  workspaceId     String
  listingId       String
  grantedByUserId String
  version         String
  grantedScopes   String    @default("[]")
  grantedToolkits String    @default("[]")
  /// Scopes a newer version asks for that the installer hasn't approved yet.
  pendingScopes   String    @default("[]")
  pendingVersion  String?
  /// The install token (`SHOGO_APP_TOKEN`), secret-crypto encrypted; the ApiKey row holds its hash.
  encryptedToken  String?
  status          String    @default("active")
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId])
  @@map("app_install_grants")
}

model EventDelivery {
  id             String    @id @default(uuid())
  subscriptionId String
  eventId        String
  workspaceId    String
  status         String    @default("pending")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  runningAt      DateTime?
  responseStatus Int?
  error          String?
  summary        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  subscription EventSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  event        WorkspaceEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, eventId])
  @@index([status, nextAttemptAt])
  @@index([workspaceId])
  @@map("event_deliveries")
}

model GoalEvent {
  id        String   @id @default(uuid())
  goalId    String
  kind      String
  message   String
  metadata  String?
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
  @@map("goal_events")
}

model Project {
  id                 String    @id @default(uuid())
  name               String
  hidden             Boolean   @default(false)
  description        String?
  workspaceId        String
  tier               String    @default("starter")
  status             String    @default("draft")
  schemas            String    @default("[]")
  createdBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  folderId           String?
  publishedSubdomain String?   @unique
  publishedAt        DateTime?
  // Mirrors `PublishStatus` enum in schema.prisma; SQLite has no enum
  // support so we store the string. Allowed values: idle, building,
  // uploading, configuring, live, failed. Set by apps/api/src/routes/publish.ts.
  publishStatus      String    @default("idle")
  publishError       String?
  publishStatusAt    DateTime?
  // The exact git commit + annotated tag the current publish points at.
  // See prisma/schema.prisma for the canonical comment.
  publishedCommitSha String?
  publishedTag       String?
  // When true, the published Knative service runs at min-scale=1 (never
  // scales to zero). Canonical comment in prisma/schema.prisma.
  publishedAlwaysOn  Boolean   @default(false)
  // Mirrors `AccessLevel` enum in schema.prisma; SQLite has no enum support
  // so we store the string. Allowed values: anyone, authenticated, private,
  // password. Set by apps/api/src/routes/publish.ts.
  accessLevel        String    @default("anyone")
  // Mirrors `ProjectVisibility` enum in schema.prisma. Allowed values:
  // workspace, restricted.
  visibility         String    @default("workspace")
  // SHA-256 hash (hex) of the published-site password, salted by subdomain.
  // Only set when accessLevel == "password". Canonical comment in
  // prisma/schema.prisma.
  sitePasswordHash   String?
  category           String?
  siteTitle          String?
  siteDescription    String?
  thumbnailUrl       String?
  // JSON-encoded Shogo buddy look for this project's team-chat agent; null = a look generated from the project id.
  buddyLook          String?
  templateId         String?
  knativeServiceName String?
  settings           String?
  lastMessageAt      DateTime?
  // External / IDE-style project mode. See prisma/schema.prisma for the
  // canonical comment.
  workingMode        String    @default("managed")
  runtimeEnabled     Boolean   @default(true)
  // Workspace-level Slack routing considers every project enabled by
  // default (opt-out) once installed. See prisma/schema.prisma.
  slackEnabled       Boolean   @default(true)
  trustLevel         String    @default("trusted")

  // External-trigger routing. See prisma/schema.prisma for the canonical comment.
  preferredInstanceId     String?
  preferredInstancePolicy String  @default("pinned")

  // Cloud workspace sync mode. SQLite has no native enum type, so we
  // store it as TEXT with the same allowed values used by the PG enum:
  //   's3' | 'dual_shadow' | 'git_only'. The check constraint lives in
  //   the migration. See prisma/schema.prisma for the canonical comment.
  //   Default mirrors the PG schema (`git_only`); harmless on desktop
  //   where cloud sync is disabled (SHOGO_LOCAL_MODE).
  cloudSyncMode String  @default("git_only")
  // Optional SSH host for desktop Remote-SSH projects. When set, the
  // primary ProjectFolder path is resolved on the remote machine.
  remoteHostId  String?

  workspace              Workspace                       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder                 Folder?                         @relation(fields: [folderId], references: [id], onDelete: SetNull)
  members                Member[]
  inviteLinks            InviteLink[]
  featureSessions        FeatureSession[]
  chatSessions           ChatSession[]
  plans                  Plan[]
  usageEvents            UsageEvent[]
  liveSessionMeters      LiveSessionMeter[]
  checkpoints            ProjectCheckpoint[]
  githubConnection       GitHubConnection?
  integrationPolicies    IntegrationCredentialPolicy[]
  integrationGrants      UserIntegrationGrant[]
  integrationApprovals   IntegrationCredentialApproval[]
  integrationAudit       IntegrationCredentialAudit[]
  starredBy              StarredProject[]
  agentConfig            AgentConfig?
  agentTasks             AgentTask[]
  meetings               Meeting[]
  marketplaceListing     MarketplaceListing?
  voiceConfig            VoiceProjectConfig?
  agents                 ProjectAgent[]
  agentCostMetrics       AgentCostMetric[]
  modelExperiments       ModelExperiment[]
  subagentModelOverrides SubagentModelOverride[]
  agentEvalSets          AgentEvalSet[]
  projectFolders         ProjectFolder[]
  preferredInstance      Instance?                       @relation("ProjectPreferredInstance", fields: [preferredInstanceId], references: [id], onDelete: SetNull)
  // Restrict: clearing remoteHostId would silently turn a remote project into
  // a local folder project whose path is resolved on this machine.
  remoteHost             RemoteHost?                     @relation(fields: [remoteHostId], references: [id], onDelete: Restrict)
  authConfig             ProjectAuthConfig?
  authSignIns            ProjectAuthSignIn[]
  attachedSessions       ChatSessionProject[]
  attachments            ProjectAttachment[]             @relation("ProjectAttachmentAnchor")
  attachedTo             ProjectAttachment[]             @relation("ProjectAttachmentTarget")
  customDomains          CustomDomain[]
  slackWorkspaceDefaults SlackWorkspaceInstallation[]    @relation("SlackWorkspaceDefaultProject")
  slackUserDefaults      SlackUserLink[]                 @relation("SlackUserDefaultProject")
  slackUserRecent        SlackUserLink[]                 @relation("SlackUserLastUsedProject")
  slackChannelDefaults   SlackChannelSettings[]          @relation("SlackChannelDefaultProject")
  slackRoutingRules      SlackProjectRoutingRule[]

  @@index([workspaceId])
  @@index([workspaceId, hidden])
  @@index([folderId])
  @@index([preferredInstanceId])
  @@index([remoteHostId])
  @@map("projects")
}

/// Workspace-level Slack app installation. SQLite mirror of
/// prisma/schema.prisma — see the canonical model there for field comments.
model SlackWorkspaceInstallation {
  id                      String   @id @default(uuid())
  workspaceId             String   @unique
  slackTeamId             String   @unique
  slackTeamName           String?
  botAccessTokenEncrypted String
  botUserId               String?
  installerUserId         String?
  defaultProjectId        String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  workspace       Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  defaultProject  Project?                  @relation("SlackWorkspaceDefaultProject", fields: [defaultProjectId], references: [id], onDelete: SetNull)
  userLinks       SlackUserLink[]
  channelSettings SlackChannelSettings[]
  routingRules    SlackProjectRoutingRule[]

  @@index([defaultProjectId])
  @@map("slack_workspace_installations")
}

/// Per-team mapping between a Slack identity and a Shogo user identity.
model SlackUserLink {
  id                       String   @id @default(uuid())
  slackTeamId              String
  slackUserId              String
  shogoUserId              String
  personalDefaultProjectId String?
  lastUsedProjectId        String?
  // Thread continuity for casual DM chat — see prisma/schema.prisma.
  activeDmChannelId        String?
  activeDmThreadTs         String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  installation           SlackWorkspaceInstallation @relation(fields: [slackTeamId], references: [slackTeamId], onDelete: Cascade)
  shogoUser              User                       @relation(fields: [shogoUserId], references: [id], onDelete: Cascade)
  personalDefaultProject Project?                   @relation("SlackUserDefaultProject", fields: [personalDefaultProjectId], references: [id], onDelete: SetNull)
  lastUsedProject        Project?                   @relation("SlackUserLastUsedProject", fields: [lastUsedProjectId], references: [id], onDelete: SetNull)

  @@unique([slackTeamId, slackUserId])
  @@index([shogoUserId])
  @@index([personalDefaultProjectId])
  @@index([lastUsedProjectId])
  @@map("slack_user_links")
}

/// Per-channel project default configured by `@Shogo settings`.
model SlackChannelSettings {
  id               String   @id @default(uuid())
  slackTeamId      String
  slackChannelId   String
  defaultProjectId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  installation   SlackWorkspaceInstallation @relation(fields: [slackTeamId], references: [slackTeamId], onDelete: Cascade)
  defaultProject Project?                   @relation("SlackChannelDefaultProject", fields: [defaultProjectId], references: [id], onDelete: SetNull)

  @@unique([slackTeamId, slackChannelId])
  @@index([defaultProjectId])
  @@map("slack_channel_settings")
}

/// Admin-managed keyword to project mapping for the Slack base agent.
model SlackProjectRoutingRule {
  id          String   @id @default(uuid())
  slackTeamId String
  keyword     String
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  installation SlackWorkspaceInstallation @relation(fields: [slackTeamId], references: [slackTeamId], onDelete: Cascade)
  project      Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([slackTeamId, keyword])
  @@index([projectId])
  @@map("slack_project_routing_rules")
}

/// Persistent project-to-project attachment. See prisma/schema.prisma for
/// the canonical comment.
model ProjectAttachment {
  id                String   @id @default(uuid())
  projectId         String
  attachedProjectId String
  attachMode        String   @default("readwrite")
  createdAt         DateTime @default(now())

  project  Project @relation("ProjectAttachmentAnchor", fields: [projectId], references: [id], onDelete: Cascade)
  attached Project @relation("ProjectAttachmentTarget", fields: [attachedProjectId], references: [id], onDelete: Cascade)

  @@unique([projectId, attachedProjectId])
  @@index([projectId])
  @@index([attachedProjectId])
  @@map("project_attachments")
}

/// External host folder linked to a project (workingMode='external').
/// See prisma/schema.prisma for the canonical comment.
model ProjectFolder {
  id           String    @id @default(uuid())
  projectId    String
  path         String
  isPrimary    Boolean   @default(false)
  addedAt      DateTime  @default(now())
  lastOpenedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_folders")
}

/// A saved SSH host used by a desktop Remote-SSH project.
/// This model is intentionally local-only; cloud projects use cloud
/// substrates instead of the desktop user's SSH credentials.
model RemoteHost {
  id              String    @id @default(uuid())
  label           String
  sshTarget       String
  port            Int?
  identityFile    String?
  platform        String?
  lastConnectedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  projects Project[]

  @@index([sshTarget])
  @@map("remote_hosts")
}

/// Bring-your-own custom domain for a published project (Cloudflare for
/// SaaS custom hostname). See prisma/schema.prisma for the canonical
/// comment. SQLite has no native enum, so `status` is TEXT with the same
/// allowed values as the PG `CustomDomainStatus` enum: pending, verifying,
/// active, failed.
model CustomDomain {
  id                 String    @id @default(uuid())
  projectId          String
  hostname           String    @unique
  status             String    @default("pending")
  cfCustomHostnameId String?
  sslStatus          String?
  lastError          String?
  groupId            String?
  primary            Boolean   @default(true)
  verifiedAt         DateTime?
  certAuthority      String?
  lastCheckedAt      DateTime?
  lastRetriggerAt    DateTime?
  retriggerCount     Int       @default(0)
  dnsOk              Boolean?
  diagnostics        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([groupId])
  @@map("custom_domains")
}

/// Per-project sign-in allowlist. See prisma/schema.prisma for the
/// canonical comment. SQLite has no native String[] so the two list
/// columns are stored as JSON-encoded TEXT (`["alice@x.com",...]`).
model ProjectAuthConfig {
  id                       String   @id @default(uuid())
  projectId                String   @unique
  mode                     String   @default("anyone")
  allowedEmails            String   @default("[]")
  allowedDomains           String   @default("[]")
  requireEmailVerification Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_auth_configs")
}

/// Tracks (project, user) sign-ins via Shogo SDK auth. See
/// prisma/schema.prisma for the canonical comment.
model ProjectAuthSignIn {
  id            String   @id @default(uuid())
  projectId     String
  userId        String
  firstSignInAt DateTime @default(now())
  lastSignInAt  DateTime @default(now())
  signInCount   Int      @default(1)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId, lastSignInAt(sort: Desc)])
  @@map("project_auth_sign_ins")
}

model AgentConfig {
