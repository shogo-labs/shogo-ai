model InfraSnapshot {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())

  // Which region's collector wrote this row. Nullable because this table is
  // shared across regions via the bidirectional logical-replication mesh
  // (see docs/oci-multi-region-production-guide.md) and rows created before
  // this column existed have no region tag. New rows are always stamped with
  // the writer's REGION_ID so `/analytics/infra-history` can scope a region's
  // chart to that region's own snapshots instead of the replicated global set.
  region String?

  totalNodes     Int
  asgDesired     Int
  asgMax         Int
  totalPodSlots  Int
  usedPodSlots   Int
  totalCpuMillis Int
  usedCpuMillis  Int
  limitCpuMillis Int @default(0)

  warmAvailable Int
  warmTarget    Int
  warmAssigned  Int
  coldStarts    Int @default(0)

  totalProjects   Int
  readyProjects   Int
  runningProjects Int
  scaledToZero    Int

  orphansDeleted Int @default(0)
  idleEvictions  Int @default(0)

  @@index([timestamp])
  @@index([region, timestamp])
  @@map("infra_snapshots")
}

