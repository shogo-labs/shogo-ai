  if (!prisma) {
    throw new Error("Prisma client not set. Call setPrisma() first.")
  }
  return prisma
}

/**
 * Build route context from Hono context
 */
function buildContext(c: any, body?: any) {
  const auth = c.get("auth")
  return {
    body: body || {},
    params: c.req.param() || {},
    query: Object.fromEntries(new URL(c.req.url).searchParams),
    userId: auth?.userId,
    tunnelAuthenticated: !!auth?.tunnelAuthenticated,
    auth,
    prisma: getPrisma(),
  }
}

/**
 * HTTP status for a hook rejection. Hooks signal authorization failures
 * with \`unauthorized\` / \`forbidden\` / \`not_found\` / \`wrong_account\` codes,
 * and state conflicts with \`already_member\` / \`last_owner\` /
 * \`trial_seat_limit\`.
 */
function hookErrorStatus(error: { code?: string } | undefined): number {
  switch (error?.code) {
    case "unauthorized": return 401
    case "forbidden": return 403
    case "wrong_account": return 403
    case "not_found": return 404
    case "already_member":
    case "last_owner":
    case "trial_seat_limit": return 409
    default: return 400
  }
}

// Field allowlists derived from the Prisma schema at code-gen time. Used
// by \`pickWritableFields\` to keep the create/update payload Prisma-safe.
const WRITABLE_SCALAR_FIELDS = ["name", "completed", "priority", "createdAt", "workspaceId"] as const
const RELATION_FIELDS = ["workspace"] as const
const MODEL_FIELDS: readonly string[] = ["id", "name", "completed", "priority", "createdAt", "workspaceId", "workspace"]

type WritableFieldKind =
  | "string" | "date" | "int" | "float" | "bigint" | "boolean"
  | "decimal" | "json" | "bytes" | "enum" | "any"
type WritableFieldSpec = { kind: WritableFieldKind; values?: readonly string[] }
type Coerced = { ok: true; value: unknown } | { ok: false; message: string }

// What each writable field IS, not just its name. The names above stop a body
// from reaching fields the schema does not expose; this stops a value of the
// wrong type from reaching a field it does.
const WRITABLE_FIELD_SPECS: Record<string, WritableFieldSpec> = {
  "name": { kind: "string" },
  "completed": { kind: "boolean" },
  "priority": { kind: "int" },
  "createdAt": { kind: "date" },
  "workspaceId": { kind: "string" },
}

/**
 * Coerce one create/update value to the type the schema declares.
 *
 * Why: the allowlist above is a list of names, so \`{ readAt: 1795789274445 }\`
 * — epoch millis, which is what \`Date.getTime()\` and any JSON client send —
 * reached a DateTime column as an Int and Prisma answered 500. Date/Int/
 * Float/BigInt/Boolean values are now coerced and an enum is checked against
 * its members; a value that cannot be coerced is rejected here so the route
 * can answer 400 and name the field.
 *
 * Anything already valid keeps working, including the Prisma field-operation
 * shapes an update may carry (\`{ increment: 1 }\`, \`{ set: [...] }\`): a plain
 * object is passed through untouched.
 */
function coerceWritableValue(key: string, value: unknown): Coerced {
  const spec = WRITABLE_FIELD_SPECS[key]
  if (!spec || spec.kind === "any" || value === null) return { ok: true, value }
  if (Array.isArray(value)) {
    const out: unknown[] = []
    for (const item of value) {
      const each = coerceScalar(spec, item)
      if (!each.ok) return { ok: false, message: \`Field "\${key}" \${each.message}\` }
      out.push(each.value)
    }
    return { ok: true, value: out }
  }
  if (typeof value === "object" && !(value instanceof Date)) {
    return { ok: true, value }
  }
  const coerced = coerceScalar(spec, value)
  if (!coerced.ok) return { ok: false, message: \`Field "\${key}" \${coerced.message}\` }
  return { ok: true, value: coerced.value }
}

function coerceScalar(spec: WritableFieldSpec, value: unknown): Coerced {
  switch (spec.kind) {
    case "date": {
      if (value instanceof Date) return { ok: true, value }
      if (typeof value === "number" && Number.isFinite(value)) return { ok: true, value: new Date(value) }
      if (typeof value === "string" && value.trim() !== "") {
        const raw = value.trim()
        const date = /^-?[0-9]+$/.test(raw) ? new Date(Number(raw)) : new Date(raw)
        if (!Number.isNaN(date.getTime())) return { ok: true, value: date }
      }
      return { ok: false, message: "must be an ISO string, epoch millis, or a Date" }
    }
    case "int": {
      const n = typeof value === "number"
        ? value
        : typeof value === "string" && value.trim() !== "" ? Number(value) : NaN
      if (Number.isInteger(n)) return { ok: true, value: n }
      return { ok: false, message: "must be an integer" }
    }
    case "float": {
      const n = typeof value === "number"
        ? value
        : typeof value === "string" && value.trim() !== "" ? Number(value) : NaN
      if (Number.isFinite(n)) return { ok: true, value: n }
      return { ok: false, message: "must be a number" }
    }
    case "boolean": {
      if (typeof value === "boolean") return { ok: true, value }
      if (value === "true" || value === 1) return { ok: true, value: true }
      if (value === "false" || value === 0) return { ok: true, value: false }
      return { ok: false, message: "must be a boolean" }
    }
    case "bigint": {
      if (typeof value === "bigint") return { ok: true, value }
      if (typeof value === "number" && Number.isInteger(value)) return { ok: true, value: BigInt(value) }
      if (typeof value === "string" && /^[+-]?[0-9]+$/.test(value.trim())) {
        return { ok: true, value: BigInt(value.trim()) }
      }
      return { ok: false, message: "must be an integer" }
    }
    case "string":
      if (typeof value === "string") return { ok: true, value }
      return { ok: false, message: "must be a string" }
    case "enum":
      if (typeof value === "string" && (!spec.values || spec.values.length === 0 || spec.values.includes(value))) {
        return { ok: true, value }
      }
      return {
        ok: false,
        message:
          spec.values && spec.values.length > 0
            ? \`must be one of: \${spec.values.join(", ")}\`
            : "must be a string",
      }
    default:
      return { ok: true, value }
  }
}

type WriteBodyResult<T> =
  | { ok: true; data: T }
  | { ok: false; error: { code: string; message: string } }

/**
 * Build a Prisma-safe \`data\` payload from the request body:
 * - Scalar/enum fields are passed through (only fields the schema declares).
 * - Relation fields must use Prisma's nested-write shape (an object like
 *   \`{ connect: { id: ... } }\` or \`{ create: { ... } }\`), not a raw scalar
 *   or array. The common bug \`{ scorecards: 1 }\` would otherwise crash with
 *   "Argument \`scorecards\`: Invalid value provided. Expected
 *    XCreateNestedManyWithoutYInput, provided Int." We surface it as a 400.
 * - Scalar values are coerced to the field type (see coerceWritableValue); a
 *   value that cannot be is a 400 naming the field, not a Prisma 500.
 * - Unknown keys are silently dropped to prevent injection of fields the
 *   schema does not expose.
 */
function pickWritableFields<T>(body: any): WriteBodyResult<T> {
  if (body == null || typeof body !== "object" || Array.isArray(body)) {
    return { ok: false, error: { code: "invalid_body", message: "Request body must be a JSON object." } }
  }
  const data: Record<string, unknown> = {}
  for (const key of WRITABLE_SCALAR_FIELDS) {
    if (body[key] === undefined) continue
    const coerced = coerceWritableValue(key, body[key])
    if (!coerced.ok) {
      return { ok: false, error: { code: "invalid_field_value", message: coerced.message } }
    }
    data[key] = coerced.value
  }
  for (const key of RELATION_FIELDS) {
    const value = body[key]
    if (value === undefined || value === null) continue
    if (typeof value !== "object" || Array.isArray(value)) {
      return {
        ok: false,
        error: {
          code: "invalid_relation_shape",
          message: \`Field "\${key}" is a relation. Provide it as { connect: { id: ... } } or { create: { ... } }, not a scalar/array.\`,
        },
      }
    }
    data[key] = value
  }
  return { ok: true, data: data as T }
}

/**
 * Create Project CRUD routes
 */
export function createProjectRoutes(): Hono {
  const router = new Hono()

  // GET / - List all
  router.get("/", async (c) => {
    try {
      const ctx = buildContext(c)
      const prisma = getPrisma()
      const query = ctx.query
      
      // Build initial where from query params (exclude pagination/meta params)
      const reservedParams = ["limit", "offset", "userId", "include", "orderBy"]
      let where: any = {}
      
      for (const [key, value] of Object.entries(query)) {
        if (!reservedParams.includes(key) && value !== undefined && value !== null && value !== "") {
          // A field the model does not have cannot be a filter. It used to
          // be handed to Prisma as a \`where\` clause it rejects, so a typo
          // came back a 500 "Unknown argument". Skip it — do not 400 it:
          // generated list routes share their query string with the
          // \`beforeList\` hook, and hooks legitimately read params that are
          // not columns (chat-session.hooks.ts maps ?projectId= onto
          // contextId). Rejecting those would break the caller before the
          // hook ever ran, with a 400 it cannot recover from.
          if (!MODEL_FIELDS.includes(key)) continue
          // Try to parse as number or boolean
          let parsedValue: any = value
          if (value === "true") parsedValue = true
          else if (value === "false") parsedValue = false
          else if (!isNaN(Number(value)) && value !== "") parsedValue = Number(value)
          
          where[key] = parsedValue
        }
      }
      
      let include: any = undefined
      let orderBy: any = undefined

      // Honor an \`orderBy\` query param of the form "field:direction"
      // (e.g. "createdAt:desc"). Without this, a \`limit\` returns an
      // arbitrary DB-ordered slice rather than the newest/oldest rows.
      if (typeof query.orderBy === "string" && query.orderBy) {
        const [field, dir] = query.orderBy.split(":")
        if (field) orderBy = { [field]: dir === "asc" ? "asc" : "desc" }
      }

      // Apply beforeList hook (can override where/include/orderBy)
      if (hooks.beforeList) {
        const result = await hooks.beforeList(ctx)
        if (result && !result.ok) {
          return sendJson(c, { error: result.error }, hookErrorStatus(result.error))
        }
        if (result?.data) {
          where = result.data.where || where
          include = result.data.include || include
          orderBy = result.data.orderBy || orderBy
        }
      }

      const [items, total] = await Promise.all([
        prisma.project.findMany({
          where,
          include,
          orderBy,
          take: query.limit ? parseInt(query.limit) : undefined,
          skip: query.offset ? parseInt(query.offset) : undefined,
        }),
        prisma.project.count({ where }),
      ])

      const shaped = hooks.afterList ? (await hooks.afterList(items, ctx)) ?? items : items
      return sendJson(c, { ok: true, items: shaped, total })
    } catch (error: any) {
      console.error("[Project] List error:", error)
      return sendJson(c, { error: { code: "list_failed", message: error.message } }, 500)
    }
  })

  // GET /:id - Get by ID
  router.get("/:id", async (c) => {
    try {
      const id = c.req.param("id")
      const ctx = buildContext(c)
      const prisma = getPrisma()

      // Apply beforeGet hook
      if (hooks.beforeGet) {
        const result = await hooks.beforeGet(id, ctx)
        if (result && !result.ok) {
          return sendJson(c, { error: result.error }, hookErrorStatus(result.error))
        }
      }

      const item = await prisma.project.findUnique({
        where: { id },
      })

      if (!item) {
        return sendJson(c, { error: { code: "not_found", message: "Project not found" } }, 404)
      }

      const shaped = hooks.afterGet ? (await hooks.afterGet(item, ctx)) ?? item : item
      return sendJson(c, { ok: true, data: shaped })
    } catch (error: any) {
      console.error("[Project] Get error:", error)
      return sendJson(c, { error: { code: "get_failed", message: error.message } }, 500)
    }
  })

  // POST / - Create
  router.post("/", async (c) => {
    try {
      let body = await c.req.json()
      const ctx = buildContext(c, body)
      const prisma = getPrisma()

      // Apply beforeCreate hook
      if (hooks.beforeCreate) {
        const result = await hooks.beforeCreate(body, ctx)
        if (result && !result.ok) {
          return sendJson(c, { error: result.error }, hookErrorStatus(result.error))
        }
        if (result?.data) {
          body = result.data
        }
      }

      // Filter the body to schema-known scalars + relation-shaped relations.
      // Prevents accidental relation-as-scalar errors and unknown-key Prisma crashes.
      const picked = pickWritableFields<Prisma.ProjectUncheckedCreateInput>(body)
      if (!picked.ok) {
        return sendJson(c, { error: picked.error }, 400)
      }

      const item = await prisma.project.create({
        data: picked.data,
      })

      // Apply afterCreate hook
      if (hooks.afterCreate) {
        await hooks.afterCreate(item, ctx)
      }

      return sendJson(c, { ok: true, data: item }, 201)
    } catch (error: any) {
      console.error("[Project] Create error:", error)
      return sendJson(c, { error: { code: "create_failed", message: error.message } }, 500)
    }
  })

  // PATCH /:id - Update
  router.patch("/:id", async (c) => {
    try {
      const id = c.req.param("id")
      let body = await c.req.json()
      const ctx = buildContext(c, body)
      const prisma = getPrisma()

      // Apply beforeUpdate hook
      if (hooks.beforeUpdate) {
        const result = await hooks.beforeUpdate(id, body, ctx)
        if (result && !result.ok) {
          return sendJson(c, { error: result.error }, hookErrorStatus(result.error))
        }
        if (result?.data) {
          body = result.data
        }
      }

      // Same allowlist filter as on create — see pickWritableFields above.
      const picked = pickWritableFields<Prisma.ProjectUncheckedUpdateInput>(body)
      if (!picked.ok) {
        return sendJson(c, { error: picked.error }, 400)
      }

      const item = await prisma.project.update({
        where: { id },
        data: picked.data,
      })

      // Apply afterUpdate hook
      if (hooks.afterUpdate) {
        await hooks.afterUpdate(item, ctx)
      }

      return sendJson(c, { ok: true, data: item })
    } catch (error: any) {
      console.error("[Project] Update error:", error)
      return sendJson(c, { error: { code: "update_failed", message: error.message } }, 500)
    }
  })

  // DELETE /:id - Delete
  router.delete("/:id", async (c) => {
    try {
      const id = c.req.param("id")
      const ctx = buildContext(c)
      const prisma = getPrisma()

      // Apply beforeDelete hook
      if (hooks.beforeDelete) {
        const result = await hooks.beforeDelete(id, ctx)
        if (result && !result.ok) {
          return sendJson(c, { error: result.error }, hookErrorStatus(result.error))
        }
      }

      if (hooks.performDelete) {
        await hooks.performDelete(id, ctx)
      } else {
        await prisma.project.delete({
          where: { id },
        })
      }

      // Apply afterDelete hook
      if (hooks.afterDelete) {
        await hooks.afterDelete(id, ctx)
      }

      return sendJson(c, { ok: true })
    } catch (error: any) {
      console.error("[Project] Delete error:", error)
      return sendJson(c, { error: { code: "delete_failed", message: error.message } }, 500)
    }
  })

  return router
}
"
`;

