        "/minimax/hailuo-2.3/standard/image-to-video": {
            "post": {
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "prompt": {
                                        "type": "string",
                                        "title": "Prompt"
                                    },
                                    "duration": {
                                        "enum": [
                                            6,
                                            10
                                        ],
                                        "type": "integer",
                                        "title": "Duration",
                                        "default": 6
                                    },
                                    "image_url": {
                                        "type": "string",
                                        "title": "Image URL",
                                        "format": "uri"
                                    },
                                    "prompt_optimizer": {
                                        "type": "boolean",
                                        "title": "Prompt optimizer",
                                        "default": true
                                    }
                                },
                                "required": [
