HUGGINGFACEHUB_API_TOKEN=
WEBARENA_SHOPPING=http://host.docker.internal:7770
WEBARENA_SHOPPING_ADMIN=http://host.docker.internal:7780
WEBARENA_CMS=http://host.docker.internal:7790
