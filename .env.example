# =============================================================================
# Shogo AI - Public Environment Example
# =============================================================================
# Copy values from this file into your local deployment environment. Do not
# commit real secrets. For local Docker development, prefer copying the values
# you need into `.env.local`.
#
# Required for a minimal self-hosted setup:
# - DATABASE_URL
# - PROJECTS_DATABASE_URL
# - REDIS_URL
# - BETTER_AUTH_SECRET
# - BETTER_AUTH_URL
# - ALLOWED_ORIGINS
# - EXPO_PUBLIC_API_URL
# - S3_ENDPOINT / S3_PUBLIC_ENDPOINT / S3_WORKSPACES_BUCKET
# - AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (or your cloud credential chain)
# - At least one AI provider key
# =============================================================================

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
APP_URL=http://localhost:8081
BETTER_AUTH_URL=http://localhost:8002
SHOGO_PUBLIC_API_URL=http://localhost:8002
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173
EXPO_PUBLIC_API_URL=http://localhost:8002
EXPO_PUBLIC_LOCAL_MODE=false

# -----------------------------------------------------------------------------
# Core secrets
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
AI_PROXY_SECRET=
PREVIEW_TOKEN_SECRET=
# AES-256-GCM master key for encrypting provider API keys at rest: both
# super-admin "Custom Providers" and the native provider keys (OpenAI /
# Anthropic) entered in Available Models. Required before any such key can be
# saved (cloud admin). Local/desktop BYOK keys mirror to env instead, so this
# is only required there if you use the encrypted admin key store.
# Generate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=
APP_NAME=Shogo AI

# -----------------------------------------------------------------------------
# Slack Agent (workspace OAuth + Events API)
# -----------------------------------------------------------------------------
# Create a Slack app from docs/slack/manifest.yml. The signing secret is used
# to authenticate every inbound Slack request; bot access tokens are encrypted
# in the database with SECRETS_ENCRYPTION_KEY.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_APP_ID=

# -----------------------------------------------------------------------------
# Team chat on Microsoft Teams and Google Chat (optional)
# -----------------------------------------------------------------------------
# Teams: a multi-tenant Azure Bot whose messaging endpoint is
# https://<your-public-host>/api/chat-providers/teams/events.
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
# Google Chat: a Chat app with HTTP endpoint
# https://<your-public-host>/api/chat-providers/google_chat/events.
# Audience is the GCP project number (or the endpoint URL for ID-token auth);
# the service account (JSON or base64 JSON) posts replies with scope chat.bot.
GOOGLE_CHAT_AUDIENCE=
GOOGLE_CHAT_SERVICE_ACCOUNT=

# -----------------------------------------------------------------------------
# Agents in team chat (optional)
# -----------------------------------------------------------------------------
# Agents @mentioning agents in a thread run them in turn. Limits per thread;
# hitting one pauses the chain and tags the person who started it. Defaults:
# 12 hand-offs, 40 agent replies since the last human message, 4 alternating
# replies between the same two agents.
# SHOGO_AGENT_CHAIN_MAX_DEPTH=12
# SHOGO_AGENT_CHAIN_MAX_THREAD_TURNS=40
# SHOGO_AGENT_CHAIN_MAX_PING_PONG=4
# Per-reply timeout and concurrent replies per workspace.
# SHOGO_CHANNEL_AGENT_TIMEOUT_MS=1800000
# SHOGO_CHANNEL_AGENT_CONCURRENCY=6

# -----------------------------------------------------------------------------
# Databases and cache
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://shogo:change-me@localhost:5432/shogo
PROJECTS_DATABASE_URL=postgres://project:change-me@localhost:5433/projects
REDIS_URL=redis://localhost:6379
# Web response cache for evals (30-day TTL, reduces duplicate Wikipedia/search requests)
WEB_CACHE_REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Storage (MinIO / S3)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_WORKSPACES_BUCKET=shogo-workspaces
S3_SCHEMA_BUCKET=shogo-schemas
S3_SCHEMA_PREFIX=schemas/
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
SCHEMA_STORAGE=s3

# -----------------------------------------------------------------------------
# Git LFS (large-file versioning, git_only mode) — see apps/api/src/routes/git-lfs.ts
# -----------------------------------------------------------------------------
# Git LFS is always on for git_only pods (the default sync mode): large files
# are tracked as pointers in git with the bytes offloaded to OCI via the batch
# endpoint, replacing the legacy size-based assets/ offload. No enable flag —
# the settings below are optional overrides (defaults shown).
# Optional dedicated bucket for LFS objects. Defaults to S3_WORKSPACES_BUCKET,
# where objects live under <projectId>/lfs/objects/<oid>.
# S3_LFS_BUCKET=shogo-lfs
# Key prefix within the project namespace (default: lfs/objects).
# S3_LFS_PREFIX=lfs/objects
# Endpoint pods use to PUT/GET LFS object bytes; must be pod-reachable AND match
# the presign signature. Defaults to S3_ENDPOINT (NOT the browser endpoint).
# S3_LFS_ENDPOINT=http://localhost:9000
# Presigned-URL TTL for LFS transfers, in seconds (default: 3600).
# LFS_PRESIGN_EXPIRY=3600

# -----------------------------------------------------------------------------
# AI providers
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
# EZ Mode GPT-Live defaults. The provider can be changed from Admin > General.
# GPT-Live delegates build requests and summaries back to Shogo, where the
# translator persona answers on the backend model (any provider). `auto` uses
# the Auto standard tier (the connected cloud's when a local instance forwards
# to Shogo Cloud).
SHOGO_EZ_MODE_LIVE_MODEL=gpt-live-1
SHOGO_EZ_MODE_LIVE_BACKEND_MODEL=auto
SHOGO_EZ_MODE_LIVE_VOICE=marin
LOCAL_LLM_BASE_URL=
LOCAL_LLM_BASIC_MODEL=
LOCAL_LLM_ADVANCED_MODEL=
LOCAL_EMBEDDING_MODEL=
LOCAL_EMBEDDING_DIMENSIONS=

# -----------------------------------------------------------------------------
# Runtime / local development
# -----------------------------------------------------------------------------
SHOGO_LOCAL_MODE=false
# Playwright browser extension token for local mode. When set and Playwright is
# enabled, the MCP server runs with --extension to control your real browser
# instead of headless Chromium. Get the token from the Playwright MCP browser
# extension. Leave blank to use --extension mode without token auth.
PLAYWRIGHT_MCP_EXTENSION_TOKEN=
WORKSPACES_DIR=./workspaces
RUNTIME_BASE_PORT=5200
RUNTIME_MAX_COUNT=10
RUNTIME_HEALTH_INTERVAL=30000
RUNTIME_DOMAIN_SUFFIX=localhost
VITE_RUNTIME_BASE=5200
VITE_RUNTIME_END=5209
VITE_DEV_PORT=5173
# Merged-root WORKSPACE runtime (multi-project, workspace-scoped chat).
# When 'true', /api/workspaces/:id/chat resolves + proxies a merged-root
# agent-runtime; when off it returns 501. Must agree with the client flag
# EXPO_PUBLIC_WORKSPACE_RUNTIME for the home "workspace chat" flow to work.
# Default off preserves the per-project chat behavior.
SHOGO_WORKSPACE_RUNTIME=false

# -----------------------------------------------------------------------------
# Local Docker port mapping
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=shogo
PORT_OFFSET=0
POSTGRES_PORT=5432
POSTGRES_PROJECTS_PORT=5433
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8002
WEB_PORT=8081
SKIP_WORKSPACE_SEEDING=1
UID=1000
GID=1000

# -----------------------------------------------------------------------------
# OAuth / auth integrations
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GH_APP_ID=
GH_APP_CLIENT_ID=
GH_APP_CLIENT_SECRET=
GH_APP_PRIVATE_KEY=
GH_APP_WEBHOOK_SECRET=
# GitHub App slug (local development uses shogo-dev-ai)
GH_APP_SLUG=
# Verified GitHub account email used in Shogo's Co-authored-by trailer.
SHOGO_AGENT_GIT_NAME=Shogo Agent
SHOGO_AGENT_GIT_EMAIL=agent@shogo.ai

# -----------------------------------------------------------------------------
# Voice / Telephony (ElevenLabs + Twilio)
# -----------------------------------------------------------------------------
# ElevenLabs powers both the in-app "EZ Mode" voice overlay and the
# SDK's Mode B (Shogo-hosted) telephony. Shogo's own API key is used to
# mint short-lived signed URLs, auto-provision per-project agents, and
# link Twilio numbers to agents via EL's native phone-numbers integration.
# Provision the shared "EZ Mode" translator agent once with:
#   ELEVENLABS_API_KEY=... bun run packages/agent-runtime/scripts/create-voice-mode-agent.ts
ELEVENLABS_API_KEY=
# Shared EZ Mode agent id used by the in-app overlay as a fallback when
# a project has no per-project VoiceProjectConfig row. Not required for
# third-party SDK usage.
ELEVENLABS_VOICE_MODE_AGENT_ID=
# HMAC secret EL signs post_call_transcription webhooks with. Configure
# the same secret in the ElevenLabs dashboard for the webhook pointing at
# POST /api/voice/elevenlabs/webhook.
ELEVENLABS_WEBHOOK_SECRET=
# Twilio account under which Shogo purchases numbers on demand for Mode B
# customers. A single account in v1; sub-accounts per workspace is a
# future upgrade path.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional: override the translator LLM. Default: claude-haiku-4-5.
SHOGO_VOICE_TRANSLATOR_MODEL=

# -----------------------------------------------------------------------------
# Affiliate / MLM program (native replacement for Rewardful)
# -----------------------------------------------------------------------------
# Master switch — when false, signup hook + webhook + cron all short-circuit.
SHOGO_AFFILIATES_NATIVE=false
# Max ENROLLMENT depth — the cap on enroll (rejects parent chains that
# would push a new affiliate beyond this). Controls how deep the referral
# tree can grow; does NOT by itself pay deep commissions (see below).
SHOGO_AFFILIATE_MAX_DEPTH=3
# Max PAYOUT depth — how many upline levels actually earn a commission on
# each invoice. 1 = direct referrer only (MLM payouts disabled by default,
# deep enrollment still works). Set to 3 to pay the full upline again.
SHOGO_AFFILIATE_PAYOUT_MAX_DEPTH=1
# Refund hold in days. Commissions become `approved` (payable) after
# `createdAt + this many days`. Matches the standard 30-day Stripe
# refund window so we never pay out on a charge that gets refunded.
SHOGO_AFFILIATE_REFUND_HOLD_DAYS=30
# Minimum approved-commission total per affiliate before a payout batch
# fires. In cents. 5000 = $50, matches Rewardful's default.
SHOGO_AFFILIATE_MIN_PAYOUT_CENTS=5000
# Click cookie window (days). Last-click attribution looks back this far.
SHOGO_AFFILIATE_COOKIE_DAYS=60
# Shared secret the marketing-site Cloudflare Function uses to
# server-to-server call POST /api/affiliates/click. Generate a long
# random string; rotate when leaked.
SHOGO_INTERNAL_SECRET=

# --- Affiliate content-CPM (Instagram / TikTok view tracking) ---------------
# This feature is OPTIONAL and fully DB-controlled by a super admin (Admin →
# Affiliate CPM, backed by `affiliate.content.*` PlatformSetting rows). There
# is intentionally NO env config for the master toggle, provider selection,
# CPM rate, hold days, or caps — most deployments never enable it. Per-creator
# CPM overrides live on each affiliate (`contentCpmCents`).
#
# The only env vars are for the EnsembleData token (a secret) and an optional
# base-URL override:
#   - EnsembleData API token. PREFER the encrypted PlatformSetting
#     `provider-key.ensembledata` (set via the admin UI) in cloud; this env var
#     is the local/dev fallback only. Never commit a real token.
ENSEMBLEDATA_API_TOKEN=
#   - Optional override of the EnsembleData base URL (tests / self-host proxy).
ENSEMBLEDATA_BASE_URL=
#   - Per-project daily cap for the agent `social_media` tool (default 200).
#     Set to 0 to disable the cap. Each call spends EnsembleData units.
# SOCIAL_TOOL_DAILY_LIMIT=200

