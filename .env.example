# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@updates.shogo.ai
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_SECURE=true
SMTP_FROM_EMAIL=noreply@updates.shogo.ai
SMTP_FROM_NAME="Shogo"

# -----------------------------------------------------------------------------
# Integrations and search
# -----------------------------------------------------------------------------
COMPOSIO_API_KEY=
COMPOSIO_PROJECT_ID=
COMPOSIO_GOOGLE_AUTH_CONFIG=
COMPOSIO_SLACK_AUTH_CONFIG=
COMPOSIO_GITHUB_AUTH_CONFIG=
COMPOSIO_LINEAR_AUTH_CONFIG=
COMPOSIO_NOTION_AUTH_CONFIG=
SERPER_API_KEY=

# -----------------------------------------------------------------------------
# Publishing / previews / infrastructure
# -----------------------------------------------------------------------------
PUBLISH_BUCKET=
PUBLISH_CLOUDFRONT_ID=
PUBLISH_DOMAIN=
PROJECTS_DB_ADMIN_URL=
PROJECTS_DB_HOST=
PROJECTS_DB_PORT=
PROJECT_NAMESPACE=
SYSTEM_NAMESPACE=
RUNTIME_IMAGE=
PREVIEW_BASE_DOMAIN=
PREVIEW_ENVIRONMENT=
POSTGRES_ENABLED=

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=shogo-api
OTEL_LOG_LEVEL=
SIGNOZ_INGESTION_KEY=
# Logs are exported to <OTEL_EXPORTER_OTLP_ENDPOINT>/v1/logs (correlated with
# traces) whenever OTEL is enabled — no extra endpoint needed. Set to "false"
# to stop mirroring API console.* output into OTLP logs (stdout is unaffected).
OTEL_LOGS_CONSOLE_BRIDGE=

# -----------------------------------------------------------------------------
# Misc tuning
# -----------------------------------------------------------------------------
AUTH_POOL_SIZE=
PRISMA_POOL_SIZE=
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# -----------------------------------------------------------------------------
# iPhone Live Activity pushes (APNs token auth)
# Lets the API start and update the Lock Screen Live Activity while the app is
# closed. Leave unset to skip: the app still drives the activity while it runs.
# Create an APNs key (.p8) at developer.apple.com → Keys.
# -----------------------------------------------------------------------------
APNS_KEY_ID=
APNS_TEAM_ID=
# Contents of the .p8 file; newlines may be written as \n
APNS_PRIVATE_KEY=
# Defaults to ai.shogo.app
APNS_BUNDLE_ID=
# true while testing a development build (uses api.sandbox.push.apple.com)
APNS_SANDBOX=

# -----------------------------------------------------------------------------
# Loops — Lifecycle Marketing Automation (loops.so)
# Get your API key from loops.so → Settings → API
# One key covers contacts, events, and all workflows.
# -----------------------------------------------------------------------------
LOOPS_API_KEY=

